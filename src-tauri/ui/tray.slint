// The tray icon and its menu (SPEC §4.1, §6.5): Show/Hide bar · Lock · Popups · Settings… · Quit.
// Left click toggles the bar. Rust keeps the properties in sync with the config and the bar.
import { I18n } from "i18n.slint";

export component Tray inherits SystemTrayIcon {
    in property <bool> icon-visible: true;
    in property <bool> bar-visible: true;
    in-out property <bool> locked;
    in-out property <bool> popups-enabled;

    callback toggle-bar();
    callback toggle-lock();
    callback toggle-popups();
    callback open-settings();
    callback quit();

    icon: @image-url("../icons/32x32.png");
    tooltip: I18n.tr("tray.tooltip");
    visible: root.icon-visible;
    clicked => {
        root.toggle-bar();
    }

    Menu {
        MenuItem {
            title: root.bar-visible ? I18n.tr("tray.hideBar") : I18n.tr("tray.showBar");
            activated => {
                root.toggle-bar();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: I18n.tr("tray.lock");
            checkable: true;
            checked <=> root.locked;
            activated => {
                root.toggle-lock();
            }
        }

        MenuItem {
            title: I18n.tr("tray.popups");
            checkable: true;
            checked <=> root.popups-enabled;
            activated => {
                root.toggle-popups();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: I18n.tr("tray.settings");
            activated => {
                root.open-settings();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: I18n.tr("tray.quit");
            activated => {
                root.quit();
            }
        }
    }
}
