{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infodock",
  "mainBinaryName": "infodock",
  "version": "0.1.0",
  "identifier": "app.infodock.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' icon: http://icon.localhost skin: http://skin.localhost data: blob:; style-src 'self' 'unsafe-inline'; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "A compact system-information and launcher bar",
    "copyright": "Copyright (c) 2026 jurakovic",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
