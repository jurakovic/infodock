<Application
    x:Class="InfodockSettings.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The width of a setting's control, as in the Slint window (Look.control-width). -->
            <x:Double x:Key="ControlWidth">240</x:Double>

            <!-- A page's cards: 4 px apart, as Windows 11 Settings sets them. -->
            <Style x:Key="CardList" TargetType="StackPanel">
                <Setter Property="Spacing" Value="4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
