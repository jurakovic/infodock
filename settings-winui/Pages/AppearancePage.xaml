<Page
    x:Class="InfodockSettings.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InfodockSettings"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <Grid Padding="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
            </Grid.ColumnDefinitions>
            <StackPanel Style="{StaticResource CardList}">
                <toolkit:SettingsCard
                    Header="{local:Tr Key=settings.appearance.theme}"
                    Description="{local:Tr Key=settings.appearance.theme.help}">
                    <ComboBox
                        x:Name="Theme"
                        Width="{StaticResource ControlWidth}"
                        AutomationProperties.Name="{local:Tr Key=settings.appearance.theme}"
                        SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="{local:Tr Key=settings.appearance.theme.modern}" />
                        <ComboBoxItem Content="{local:Tr Key=settings.appearance.theme.classic}" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    Header="{local:Tr Key=settings.appearance.colorScheme}"
                    Description="{local:Tr Key=settings.appearance.colorScheme.help}">
                    <ComboBox
                        x:Name="ColorScheme"
                        Width="{StaticResource ControlWidth}"
                        AutomationProperties.Name="{local:Tr Key=settings.appearance.colorScheme}"
                        SelectionChanged="OnColorSchemeChanged">
                        <ComboBoxItem Content="{local:Tr Key=settings.appearance.colorScheme.system}" />
                        <ComboBoxItem Content="{local:Tr Key=settings.appearance.colorScheme.light}" />
                        <ComboBoxItem Content="{local:Tr Key=settings.appearance.colorScheme.dark}" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard x:Name="ColorModeCard" Header="{local:Tr Key=settings.appearance.colorMode}">
                    <ComboBox
                        x:Name="ColorMode"
                        Width="{StaticResource ControlWidth}"
                        AutomationProperties.Name="{local:Tr Key=settings.appearance.colorMode}"
                        SelectionChanged="OnColorModeChanged">
                        <ComboBoxItem Content="{local:Tr Key=settings.appearance.colorMode.standard}" />
                        <ComboBoxItem Content="{local:Tr Key=settings.appearance.colorMode.custom}" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <!-- A colour as #RRGGBB, or picked with WinUI's colour picker from the swatch. -->
                <toolkit:SettingsCard x:Name="ColorCard" Header="{local:Tr Key=settings.appearance.color}">
                    <StackPanel Spacing="8">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <DropDownButton x:Name="Swatch" Padding="6" AutomationProperties.Name="{local:Tr Key=settings.appearance.color}">
                                <Border
                                    x:Name="SwatchFill"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="2"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                <DropDownButton.Flyout>
                                    <Flyout>
                                        <ColorPicker
                                            x:Name="Picker"
                                            IsAlphaEnabled="False"
                                            IsMoreButtonVisible="False"
                                            IsColorChannelTextInputVisible="False"
                                            ColorChanged="OnPickerColorChanged" />
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <TextBox
                                x:Name="ColorText"
                                Width="120"
                                AutomationProperties.Name="{local:Tr Key=settings.appearance.color}"
                                TextChanged="OnColorTextChanged" />
                        </StackPanel>
                        <Button
                            x:Name="ColorReset"
                            HorizontalAlignment="Right"
                            Content="{local:Tr Key=settings.reset}"
                            Click="OnColorReset" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard x:Name="OpacityCard" Header="{local:Tr Key=settings.appearance.opacity}">
                    <StackPanel Spacing="8">
                        <StackPanel Width="{StaticResource ControlWidth}" Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Name="OpacityValue"
                                Width="64"
                                TextAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Slider
                                x:Name="OpacitySlider"
                                Width="168"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                AutomationProperties.Name="{local:Tr Key=settings.appearance.opacity}"
                                ValueChanged="OnOpacityChanged" />
                        </StackPanel>
                        <Button
                            x:Name="OpacityReset"
                            HorizontalAlignment="Right"
                            Content="{local:Tr Key=settings.reset}"
                            Click="OnOpacityReset" />
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard x:Name="MaterialCard" Header="{local:Tr Key=settings.appearance.material}">
                    <ComboBox
                        x:Name="Material"
                        Width="{StaticResource ControlWidth}"
                        AutomationProperties.Name="{local:Tr Key=settings.appearance.material}" />
                </toolkit:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
