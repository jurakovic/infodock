<Window
    x:Class="InfodockSettings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InfodockSettings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar, as Windows 11 Settings draws it: the icon and the title on Mica. -->
        <Grid x:Name="AppTitleBar">
            <StackPanel Margin="16,0,0,0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock
                    Text="{local:Tr Key=settings.title}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Expanded at any width, as the Slint window's navigation is. -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="220"
            AutomationProperties.Name="{local:Tr Key=settings.nav.label}"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.Resources>
                <!-- No layer behind the pages: Windows 11 Settings shows them on Mica. -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="general" Content="{local:Tr Key=settings.nav.general}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="bar" Content="{local:Tr Key=settings.nav.bar}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="appearance" Content="{local:Tr Key=settings.nav.appearance}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="sensors" Content="{local:Tr Key=settings.nav.sensors}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="popups" Content="{local:Tr Key=settings.nav.popups}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="applications" Content="{local:Tr Key=settings.nav.applications}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="help" Content="{local:Tr Key=settings.nav.help}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="about" Content="{local:Tr Key=settings.nav.about}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Windows 11's Title, fixed above the page as in Windows 11 Settings. -->
                <TextBlock
                    x:Name="PageTitle"
                    Margin="24,4,24,20"
                    Style="{StaticResource TitleTextBlockStyle}"
                    AutomationProperties.HeadingLevel="Level1" />
                <Frame x:Name="PageFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
