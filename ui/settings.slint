// The Settings window (SPEC §10.7): General, Bar, Sensors and Popups pages, a sensor's
// properties and the sensor picker. Rust fills `SettingsState` from the config and handles its
// callbacks; controls bind to it two-way, and every change is saved through a settings patch.
import { Button, ComboBox, LineEdit, Palette, ScrollView, Slider, StandardListView, Switch } from "std-widgets.slint";
import { I18n } from "i18n.slint";

// One field of a sensor's properties form (SPEC §6.7, §8.2); see `settings/form.rs`.
export struct PropRow {
    key: string,
    // 0 text, 1 switch, 2 list, 3 slider, 4 colour, 5 colour mode, 6 file, 7 folder.
    kind: int,
    label: string,
    help: string,
    visible: bool,
    text: string,
    checked: bool,
    number: float,
    minimum: float,
    maximum: float,
    step: float,
    // A message key with a `{value}` placeholder.
    unit: string,
    options: [string],
    index: int,
    color: string,
    // Why the value typed last cannot be used; empty if it can.
    error: string,
}

// One line of the sensor picker (SPEC §6.6): a category heading or a sensor type.
export struct PickerRow {
    heading: bool,
    name: string,
    description: string,
    // The type's index, for `picker-selected`; -1 for a heading.
    entry: int,
}

// One line of the Layout manager (SPEC §10.7).
export struct LayoutRow {
    // 0 = a zone's heading, 1 = a sensor, 2 = the note in an empty zone.
    kind: int,
    // 0 = left, 1 = center, 2 = right.
    zone: int,
    id: string,
    name: string,
    detail: string,
    editable: bool,
    // The sensor can move up / down the list (across zones).
    up: bool,
    down: bool,
}

export global SettingsState {
    // 0 = General, 1 = Bar, 2 = Sensors, 3 = Popups; 4 = a sensor's properties, 5 = the picker.
    in-out property <int> page;

    // General (SPEC §10.1)
    in property <string> hotkey;
    // Set while the hotkey button waits for a combination; Rust reads the keys (they are
    // physical keys, which Slint's key events do not carry) and clears it.
    in-out property <bool> recording-hotkey;
    // Why the hotkey could not be registered or recorded; empty when it works.
    in property <string> hotkey-error;
    in-out property <int> hotkey-action;
    in-out property <bool> show-tray-icon;
    in-out property <bool> locked;
    in-out property <bool> popups-enabled;
    in-out property <int> clicks-when-locked;
    in-out property <float> sensor-spacing;
    // 0 = the picker, 1 = a submenu of types.
    in-out property <int> new-sensor-menu;

    // Bar (SPEC §10.2)
    // 0 = docked, 1 = floating.
    in-out property <int> mode;
    // Logical px.
    in-out property <float> floating-width;
    in-out property <int> edge;
    in property <[string]> monitors;
    in-out property <int> monitor;
    in-out property <bool> reserve-space;
    in-out property <int> z-order;
    in-out property <bool> hide-on-fullscreen;
    in-out property <bool> highlight-on-hover;
    // 0 = like Windows, 1 = on, 2 = off.
    in-out property <int> animations;
    in-out property <float> height;
    in property <int> theme-height;
    // The height differs from the theme default.
    in property <bool> height-customised;

    // Sensors (SPEC §10.4)
    in-out property <string> sensor-text-color;
    // "Theme default (…)", then the installed families.
    in property <[string]> fonts;
    in-out property <int> sensor-font;
    // "Theme default (…)", then the six styles.
    in property <[string]> sensor-font-styles;
    in-out property <int> sensor-font-style;
    // 0 = fade, 1 = tint.
    in-out property <int> inactive-mode;
    in-out property <string> inactive-color;
    in-out property <float> inactive-opacity;

    // Popups (SPEC §10.5)
    in-out property <string> popup-background;
    in property <bool> popup-background-customised;
    in property <string> popup-background-default;
    in-out property <float> popup-opacity;
    in property <bool> popup-opacity-customised;
    in property <int> popup-opacity-default;
    in-out property <string> popup-text-color;
    in-out property <string> popup-strong-color;
    in-out property <int> popup-font;
    in property <[string]> popup-font-styles;
    in-out property <int> popup-font-style;
    in-out property <float> popup-font-size;
    in-out property <bool> popup-shadow;
    in-out property <float> show-delay;
    in-out property <float> hide-delay;

    // A sensor's properties (SPEC §6.7)
    in property <[PropRow]> props;
    in property <string> props-title;
    in property <string> props-error;
    // No field holds an invalid value, so the form can be saved (SPEC §6.7).
    in property <bool> props-valid: true;

    // The Layout manager (SPEC §10.7)
    in property <[LayoutRow]> layout-rows;
    // The sensor whose Remove waits for confirmation.
    in-out property <string> layout-confirm;
    // A sensor just moved with its Up (or Down) button: the button takes the focus again once
    // the list shows the move, and the request is cleared.
    in-out property <string> layout-focus-id;
    in property <bool> layout-focus-up;

    // The sensor picker (SPEC §6.6)
    in property <[PickerRow]> picker-rows;
    in-out property <string> picker-search;
    // The selected type's `entry`; -1 for none.
    in-out property <int> picker-selected;
    // With a target sensor: 0 = insert before it, 1 = after it.
    in-out property <int> picker-after;
    // The target sensor's type name; empty without a target.
    in property <string> picker-target;

    // The last save error other than a hotkey error; empty when the last save worked.
    in property <string> save-error;

    // `path` is the dotted settings key, e.g. "bar.reserveSpace".
    callback set-flag(path: string, value: bool);
    callback set-choice(path: string, index: int);
    callback set-number(path: string, value: int);
    callback set-monitor(index: int);
    // A floating bar's width, logical px.
    callback set-floating-width(width: int);
    // Back to the theme default.
    callback reset(path: string);
    // A colour typed as #RRGGBB.
    callback set-color(path: string, text: string);
    // Index 0 is the theme default; then `fonts` or the font styles.
    callback set-font(path: string, index: int);
    callback set-font-style(path: string, index: int);
    // The colour of a #RRGGBB text, for swatches; transparent if it is not one.
    pure callback to-color(text: string) -> color;
    // The text is a colour as #RRGGBB.
    pure callback is-color(text: string) -> bool;

    // The navigation moved to another page (leaving the properties form cancels it).
    callback page-changed(page: int);
    // Edits in the properties form; each previews on the bar.
    callback prop-text(key: string, text: string);
    callback prop-flag(key: string, value: bool);
    callback prop-number(key: string, value: float);
    callback prop-choice(key: string, index: int);
    callback prop-color-mode(key: string, index: int, color: string);
    callback prop-browse(key: string);
    callback props-save();
    callback props-cancel();
    // Layout manager: one step up or down; a drop before line `boundary`.
    callback layout-move(id: string, up: bool);
    callback layout-drop(id: string, boundary: int);
    callback layout-edit(id: string);
    callback layout-remove(id: string);
    // Opens the picker for the end of zone `zone`.
    callback layout-add(zone: int);
    // The picker's search text changed.
    callback picker-searched(text: string);
    // Up (or Down) in the search box: the listed type above (or below) the selected one.
    callback picker-step(up: bool);
    // Adds the selected type and opens its properties.
    callback picker-add();
    callback picker-cancel();
}

// One setting, laid out like Windows Settings: label, help text and error on the left (they
// wrap), the control on the right.
component Row inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    in property <string> error;

    line := HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 24px;

        VerticalLayout {
            width: line.width - controls.preferred-width - line.spacing;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                wrap: word-wrap;
                // Wrapped text is measured at its own width (the layout would measure it at the
                // row's width and leave too little height).
                height: self.preferred-height;
                color: Palette.foreground;
            }

            if root.help != "": Text {
                text: root.help;
                wrap: word-wrap;
                height: self.preferred-height;
                font-size: 12px;
                color: Palette.foreground;
                opacity: 0.7;
            }
            if root.error != "": Text {
                text: root.error;
                wrap: word-wrap;
                height: self.preferred-height;
                font-size: 12px;
                color: #d13438;
            }
        }

        controls := VerticalLayout {
            alignment: center;
            @children
        }
    }

    Rectangle {
        height: 1px;
        background: Palette.border;
    }
}

// A slider with its value and unit shown next to it, saved when released. `unit` is a message
// key with a `{value}` placeholder, e.g. "common.px". Dragging moves in any amount, so the value
// is shown rounded to `step` and snaps to it on release: what is shown is what is saved.
component ValueSlider inherits HorizontalLayout {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in property <string> unit: "common.px";
    in-out property <float> value;
    callback released(value: int);

    function stepped(v: float) -> int {
        return Math.round(v / root.step) * root.step;
    }

    spacing: 10px;
    Slider {
        width: 180px;
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        value <=> root.value;
        accessible-label: root.label;
        released(v) => {
            root.value = root.stepped(v);
            root.released(root.value);
        }
    }

    Text {
        width: 64px;
        vertical-alignment: center;
        horizontal-alignment: right;
        text: I18n.tr-with(root.unit, "value", root.stepped(root.value));
        color: Palette.foreground;
    }
}

// A colour as #RRGGBB with a swatch. It is accepted as soon as the typed text is a colour, so
// a click that does not take the focus (Save, the navigation) finds it saved; on Enter or when
// the field loses focus it is accepted whatever it is, and an invalid one shows an error. With
// `every-edit` (the properties form, which validates as it goes) every edit is accepted.
component ColorField inherits HorizontalLayout {
    in property <string> label;
    in property <bool> every-edit;
    in-out property <string> value;
    callback accepted(text: string);

    spacing: 8px;
    alignment: end;
    Rectangle {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Palette.border;
        background: SettingsState.to-color(root.value);
    }

    edit := LineEdit {
        width: 120px;
        text <=> root.value;
        accessible-label: root.label;
        edited(text) => {
            if root.every-edit || SettingsState.is-color(text) {
                root.accepted(text);
            }
        }
        accepted(text) => {
            root.accepted(text);
        }
        changed has-focus => {
            if !self.has-focus {
                root.accepted(self.text);
            }
        }
    }
}

// The control of a setting whose default comes from the theme, with a button back to it.
component WithReset inherits VerticalLayout {
    in property <bool> customised;
    callback reset();

    spacing: 8px;
    @children
    HorizontalLayout {
        alignment: end;
        Button {
            text: I18n.tr("settings.reset");
            enabled: root.customised;
            clicked => {
                root.reset();
            }
        }
    }
}

component GeneralPage inherits VerticalLayout {
    alignment: start;

    Row {
        label: I18n.tr("settings.general.hotkey");
        help: I18n.tr("settings.general.hotkey.help");
        error: SettingsState.hotkey-error;
        Button {
            width: 200px;
            text: SettingsState.recording-hotkey ? I18n.tr("settings.general.hotkey.recording") : SettingsState.hotkey;
            primary: SettingsState.recording-hotkey;
            accessible-label: I18n.tr("settings.general.hotkey");
            clicked => {
                SettingsState.recording-hotkey = !SettingsState.recording-hotkey;
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.hotkeyAction");
        ComboBox {
            width: 240px;
            model: [
                I18n.tr("settings.general.hotkeyAction.bringToFront"),
                I18n.tr("settings.general.hotkeyAction.toggleVisibility"),
            ];
            current-index <=> SettingsState.hotkey-action;
            accessible-label: I18n.tr("settings.general.hotkeyAction");
            selected => {
                SettingsState.set-choice("hotkeyAction", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.showTrayIcon");
        Switch {
            checked <=> SettingsState.show-tray-icon;
            accessible-label: I18n.tr("settings.general.showTrayIcon");
            toggled => {
                SettingsState.set-flag("showTrayIcon", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.locked");
        help: I18n.tr("settings.general.locked.help");
        Switch {
            checked <=> SettingsState.locked;
            accessible-label: I18n.tr("settings.general.locked");
            toggled => {
                SettingsState.set-flag("locked", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.popupsEnabled");
        Switch {
            checked <=> SettingsState.popups-enabled;
            accessible-label: I18n.tr("settings.general.popupsEnabled");
            toggled => {
                SettingsState.set-flag("popupsEnabled", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.clicksWhenLocked");
        ComboBox {
            width: 240px;
            model: [
                I18n.tr("settings.general.clicksWhenLocked.always"),
                I18n.tr("settings.general.clicksWhenLocked.altOnly"),
            ];
            current-index <=> SettingsState.clicks-when-locked;
            accessible-label: I18n.tr("settings.general.clicksWhenLocked");
            selected => {
                SettingsState.set-choice("clicksWhenLocked", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.sensorSpacing");
        ValueSlider {
            label: I18n.tr("settings.general.sensorSpacing");
            minimum: 1;
            maximum: 20;
            value <=> SettingsState.sensor-spacing;
            released(v) => {
                SettingsState.set-number("sensorSpacing", v);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.newSensorMenu");
        help: I18n.tr("settings.general.newSensorMenu.help");
        ComboBox {
            width: 240px;
            model: [
                I18n.tr("settings.general.newSensorMenu.dialog"),
                I18n.tr("settings.general.newSensorMenu.submenu"),
            ];
            current-index <=> SettingsState.new-sensor-menu;
            accessible-label: I18n.tr("settings.general.newSensorMenu");
            selected => {
                SettingsState.set-choice("newSensorMenu", self.current-index);
            }
        }
    }
}

component BarPage inherits VerticalLayout {
    alignment: start;

    Row {
        label: I18n.tr("settings.bar.mode");
        help: I18n.tr("settings.bar.mode.help");
        ComboBox {
            width: 240px;
            model: [I18n.tr("settings.bar.mode.docked"), I18n.tr("settings.bar.mode.floating")];
            current-index <=> SettingsState.mode;
            accessible-label: I18n.tr("settings.bar.mode");
            selected => {
                SettingsState.set-choice("bar.mode", self.current-index);
            }
        }
    }

    if SettingsState.mode == 1: Row {
        label: I18n.tr("settings.bar.width");
        ValueSlider {
            label: I18n.tr("settings.bar.width");
            minimum: 200;
            maximum: 3840;
            step: 10;
            value <=> SettingsState.floating-width;
            released(v) => {
                SettingsState.set-floating-width(v);
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.edge");
        ComboBox {
            width: 240px;
            model: [I18n.tr("settings.bar.edge.top"), I18n.tr("settings.bar.edge.bottom")];
            current-index <=> SettingsState.edge;
            accessible-label: I18n.tr("settings.bar.edge");
            selected => {
                SettingsState.set-choice("bar.edge", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.monitor");
        ComboBox {
            width: 240px;
            model: SettingsState.monitors;
            current-index <=> SettingsState.monitor;
            accessible-label: I18n.tr("settings.bar.monitor");
            selected => {
                SettingsState.set-monitor(self.current-index);
            }
        }
    }

    if SettingsState.mode == 0: Row {
        label: I18n.tr("settings.bar.reserveSpace");
        help: I18n.tr("settings.bar.reserveSpace.help");
        Switch {
            checked <=> SettingsState.reserve-space;
            accessible-label: I18n.tr("settings.bar.reserveSpace");
            toggled => {
                SettingsState.set-flag("bar.reserveSpace", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.zOrder");
        help: I18n.tr("settings.bar.zOrder.help");
        ComboBox {
            width: 240px;
            model: [
                I18n.tr("settings.bar.zOrder.topmost"),
                I18n.tr("settings.bar.zOrder.normal"),
                I18n.tr("settings.bar.zOrder.bottom"),
            ];
            current-index <=> SettingsState.z-order;
            accessible-label: I18n.tr("settings.bar.zOrder");
            selected => {
                SettingsState.set-choice("bar.zOrder", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.hideOnFullscreen");
        Switch {
            checked <=> SettingsState.hide-on-fullscreen;
            accessible-label: I18n.tr("settings.bar.hideOnFullscreen");
            toggled => {
                SettingsState.set-flag("bar.hideOnFullscreen", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.height");
        help: I18n.tr-with("settings.bar.height.help", "height", SettingsState.theme-height);
        VerticalLayout {
            spacing: 8px;
            ValueSlider {
                label: I18n.tr("settings.bar.height");
                minimum: 22;
                maximum: 40;
                value <=> SettingsState.height;
                released(v) => {
                    SettingsState.set-number("bar.height", v);
                }
            }

            HorizontalLayout {
                alignment: end;
                Button {
                    text: I18n.tr("settings.reset");
                    enabled: SettingsState.height-customised;
                    clicked => {
                        SettingsState.reset("bar.height");
                    }
                }
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.highlightOnHover");
        help: I18n.tr("settings.bar.highlightOnHover.help");
        Switch {
            checked <=> SettingsState.highlight-on-hover;
            accessible-label: I18n.tr("settings.bar.highlightOnHover");
            toggled => {
                SettingsState.set-flag("bar.highlightOnHover", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.animations");
        help: I18n.tr("settings.bar.animations.help");
        ComboBox {
            width: 240px;
            model: [
                I18n.tr("settings.bar.animations.auto"),
                I18n.tr("settings.bar.animations.on"),
                I18n.tr("settings.bar.animations.off"),
            ];
            current-index <=> SettingsState.animations;
            accessible-label: I18n.tr("settings.bar.animations");
            selected => {
                SettingsState.set-choice("bar.animations", self.current-index);
            }
        }
    }
}

// A heading for a group of settings on a page.
component SectionHeading inherits VerticalLayout {
    in property <string> title;
    in property <string> help;
    spacing: 2px;
    Text {
        text: root.title;
        font-size: 16px;
        font-weight: 600;
        color: Palette.foreground;
        accessible-role: text;
    }

    if root.help != "": Text {
        text: root.help;
        wrap: word-wrap;
        font-size: 12px;
        color: Palette.foreground;
        opacity: 0.7;
    }
}

// An icon-only button.
component IconButton inherits Button {
    in property <string> label;
    colorize-icon: true;
    icon-size: 16px;
    accessible-label: self.label;
}

// The Layout manager (SPEC §10.7): each zone's sensors, which move by dragging or with the
// arrow buttons. All lines are equally tall, so a pointer position maps to a line boundary.
component LayoutList inherits Rectangle {
    property <length> line-height: 44px;
    // The sensor being dragged, and the line boundary it would drop at (-1: none).
    property <string> drag-id;
    property <int> drop-at: -1;

    height: SettingsState.layout-rows.length * self.line-height;
    accessible-role: list;
    accessible-label: I18n.tr("settings.layout.title");

    for row[i] in SettingsState.layout-rows: Rectangle {
        x: 0;
        y: i * root.line-height;
        width: parent.width;
        height: root.line-height;

        if row.kind == 0: HorizontalLayout {
            padding-top: 8px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: row.name;
                font-weight: 600;
                vertical-alignment: center;
                color: Palette.foreground;
            }

            Button {
                horizontal-stretch: 0;
                text: I18n.tr("settings.layout.add");
                icon: @image-url("icons/add.svg");
                colorize-icon: true;
                icon-size: 16px;
                accessible-label: I18n.tr-with("settings.layout.addTo", "zone", row.name);
                clicked => {
                    SettingsState.layout-add(row.zone);
                }
            }
        }

        if row.kind == 2: Text {
            x: 8px;
            text: row.name;
            vertical-alignment: center;
            color: Palette.foreground;
            opacity: 0.7;
        }

        if row.kind == 1: Rectangle {
            border-radius: 4px;
            // Dimmed while dragged, like on the bar (SPEC §6.2).
            background: touch.has-hover || root.drag-id == row.id ? Palette.alternate-background
                : transparent;
            opacity: root.drag-id == row.id ? 0.6 : 1;
            accessible-role: list-item;
            accessible-label: row.detail == "" ? row.name : row.name + ", " + row.detail;

            touch := TouchArea {
                mouse-cursor: root.drag-id == row.id ? MouseCursor.grabbing : MouseCursor.grab;
                moved => {
                    if root.drag-id == row.id || abs(self.mouse-x - self.pressed-x) > 4px
                        || abs(self.mouse-y - self.pressed-y) > 4px {
                        root.drag-id = row.id;
                        // Outside the list sideways: no drop.
                        root.drop-at = self.mouse-x < 0 || self.mouse-x > self.width ? -1
                            : max(0, min(SettingsState.layout-rows.length,
                                round((i * root.line-height + self.mouse-y) / root.line-height)));
                    }
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                        if event.kind == PointerEventKind.up && root.drag-id != "" && root.drop-at >= 0 {
                            SettingsState.layout-drop(root.drag-id, root.drop-at);
                        }
                        root.drag-id = "";
                        root.drop-at = -1;
                    }
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 4px;
                spacing: 4px;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: row.name;
                        overflow: elide;
                        color: Palette.foreground;
                    }

                    if row.detail != "": Text {
                        text: row.detail;
                        overflow: elide;
                        font-size: 12px;
                        color: Palette.foreground;
                        opacity: 0.7;
                    }
                }

                if SettingsState.layout-confirm == row.id: HorizontalLayout {
                    spacing: 4px;
                    alignment: end;
                    Text {
                        text: I18n.tr-with("menu.remove.confirm", "name", row.name);
                        vertical-alignment: center;
                        overflow: elide;
                        color: Palette.foreground;
                    }

                    Button {
                        text: I18n.tr("menu.remove.action");
                        primary: true;
                        clicked => {
                            SettingsState.layout-confirm = "";
                            SettingsState.layout-remove(row.id);
                        }
                    }

                    Button {
                        text: I18n.tr("settings.layout.cancel");
                        clicked => {
                            SettingsState.layout-confirm = "";
                        }
                    }
                }

                if SettingsState.layout-confirm != row.id: HorizontalLayout {
                    spacing: 4px;
                    alignment: end;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    // The list is rebuilt after a move, so keyboard users find their button
                    // again on the moved sensor (the other one where the list ends).
                    init => {
                        if SettingsState.layout-focus-id == row.id {
                            SettingsState.layout-focus-id = "";
                            if (SettingsState.layout-focus-up && row.up) || !row.down {
                                up.focus();
                            } else {
                                down.focus();
                            }
                        }
                    }

                    up := IconButton {
                        label: I18n.tr("settings.layout.up");
                        icon: @image-url("icons/up.svg");
                        enabled: row.up;
                        clicked => {
                            SettingsState.layout-move(row.id, true);
                        }
                    }

                    down := IconButton {
                        label: I18n.tr("settings.layout.down");
                        icon: @image-url("icons/down.svg");
                        enabled: row.down;
                        clicked => {
                            SettingsState.layout-move(row.id, false);
                        }
                    }

                    IconButton {
                        label: I18n.tr("settings.layout.edit");
                        icon: @image-url("icons/edit.svg");
                        enabled: row.editable;
                        clicked => {
                            SettingsState.layout-edit(row.id);
                        }
                    }

                    IconButton {
                        label: I18n.tr("settings.layout.remove");
                        icon: @image-url("icons/remove.svg");
                        clicked => {
                            SettingsState.layout-confirm = row.id;
                        }
                    }
                }
            }
        }
    }

    if root.drop-at >= 0: Rectangle {
        x: 0;
        y: root.drop-at * root.line-height - 1px;
        width: parent.width;
        height: 2px;
        background: Palette.accent-background;
    }
}

component SensorsPage inherits VerticalLayout {
    alignment: start;

    SectionHeading {
        title: I18n.tr("settings.layout.title");
        help: I18n.tr("settings.layout.help");
    }

    LayoutList { }

    SectionHeading {
        padding-top: 24px;
        title: I18n.tr("settings.sensors.defaults");
        help: I18n.tr("settings.sensors.defaults.help");
    }

    Row {
        label: I18n.tr("settings.sensors.textColor");
        help: I18n.tr("settings.sensors.textColor.help");
        ColorField {
            label: I18n.tr("settings.sensors.textColor");
            value <=> SettingsState.sensor-text-color;
            accepted(text) => {
                SettingsState.set-color("sensors.textColor", text);
            }
        }
    }

    Row {
        label: I18n.tr("settings.font");
        ComboBox {
            width: 280px;
            model: SettingsState.fonts;
            current-index <=> SettingsState.sensor-font;
            accessible-label: I18n.tr("settings.font");
            selected => {
                SettingsState.set-font("sensors.font", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.fontStyle");
        ComboBox {
            width: 280px;
            model: SettingsState.sensor-font-styles;
            current-index <=> SettingsState.sensor-font-style;
            accessible-label: I18n.tr("settings.fontStyle");
            selected => {
                SettingsState.set-font-style("sensors.fontStyle", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.sensors.inactiveMode");
        help: I18n.tr("settings.sensors.inactiveMode.help");
        ComboBox {
            width: 240px;
            model: [
                I18n.tr("settings.sensors.inactiveMode.opacity"),
                I18n.tr("settings.sensors.inactiveMode.colorize"),
            ];
            current-index <=> SettingsState.inactive-mode;
            accessible-label: I18n.tr("settings.sensors.inactiveMode");
            selected => {
                SettingsState.set-choice("sensors.inactiveMode", self.current-index);
            }
        }
    }

    if SettingsState.inactive-mode == 0: Row {
        label: I18n.tr("settings.sensors.inactiveOpacity");
        ValueSlider {
            label: I18n.tr("settings.sensors.inactiveOpacity");
            minimum: 0;
            maximum: 100;
            unit: "common.percent";
            value <=> SettingsState.inactive-opacity;
            released(v) => {
                SettingsState.set-number("sensors.inactiveOpacity", v);
            }
        }
    }

    if SettingsState.inactive-mode == 1: Row {
        label: I18n.tr("settings.sensors.inactiveColor");
        ColorField {
            label: I18n.tr("settings.sensors.inactiveColor");
            value <=> SettingsState.inactive-color;
            accepted(text) => {
                SettingsState.set-color("sensors.inactiveColor", text);
            }
        }
    }

}

