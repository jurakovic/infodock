// The Settings window (SPEC §10.7): General, Bar, Appearance, Sensors, Popups, Applications, Help
// and About pages, a sensor's properties, the sensor picker and the first run's welcome page (§11.5).
// Rust fills `SettingsState` from the config and handles its callbacks; controls bind to it
// two-way, and every change is saved through a settings patch.
import { AboutSlint, Button, ComboBox, LineEdit, Palette, ScrollView, Slider, StandardListView, Switch } from "std-widgets.slint";
import { I18n } from "i18n.slint";

// One field of a sensor's properties form (SPEC §6.7, §8.2); see `settings/form.rs`.
export struct PropRow {
    key: string,
    // See `RowKinds`.
    kind: int,
    label: string,
    help: string,
    visible: bool,
    text: string,
    checked: bool,
    number: float,
    minimum: float,
    maximum: float,
    step: float,
    // A message key with a `{value}` placeholder.
    unit: string,
    options: [string],
    index: int,
    color: string,
    // Why the value typed last cannot be used; empty if it can.
    error: string,
}

// One line of the sensor picker (SPEC §6.6): a category heading or a sensor type.
export struct PickerRow {
    heading: bool,
    name: string,
    description: string,
    // The type's index, for `picker-selected`; -1 for a heading.
    entry: int,
}

// One line of the Layout manager (SPEC §10.7).
export struct LayoutRow {
    // See `LineKinds`.
    kind: int,
    // 0 = left, 1 = center, 2 = right.
    zone: int,
    id: string,
    name: string,
    detail: string,
    editable: bool,
    // The sensor can move up / down the list (across zones).
    up: bool,
    down: bool,
    // Its place in its zone and how many the zone has, for screen readers.
    index: int,
    count: int,
}

// A skin in the Appearance page's gallery (SPEC §12.4).
export struct SkinTile {
    name: string,
    // Rendered by the bar's renderer; where there is none, a swatch of `swatch` instead.
    preview: image,
    has-preview: bool,
    swatch: color,
    selected: bool,
}

// A folder in the skins folder (SPEC §12.4): a pack, or why it cannot be used.
export struct SkinPackRow {
    id: string,
    name: string,
    problem: string,
}

// The pages' numbers: the navigation's in its order, then the pages it does not list. Rust has
// the same numbers (`model::PAGES`, each module's `PAGE`), and so do `RowKinds` (`RowKind::code`)
// and `LineKinds` (`LineKind::code`); `settings/contract.rs` compares them.
export global Pages {
    out property <int> general: 0;
    out property <int> bar: 1;
    out property <int> appearance: 2;
    out property <int> sensors: 3;
    out property <int> popups: 4;
    out property <int> applications: 5;
    out property <int> help: 6;
    out property <int> about: 7;
    // Pages the navigation does not list.
    out property <int> properties: 8;
    out property <int> picker: 9;
    out property <int> welcome: 10;
}

// How a row of the properties form is edited (`PropRow.kind`).
export global RowKinds {
    out property <int> text: 0;
    out property <int> flag: 1;
    out property <int> choice: 2;
    out property <int> number: 3;
    out property <int> color: 4;
    out property <int> color-mode: 5;
    out property <int> file: 6;
    out property <int> folder: 7;
}

// What a line of the Layout manager is (`LayoutRow.kind`).
export global LineKinds {
    out property <int> heading: 0;
    out property <int> sensor: 1;
    out property <int> empty: 2;
}

// Windows 11's layers, which the Fluent palette has no names for: the window behind the
// navigation and the pages, the cards on it, and the subtle fills of a list's items. Solid, as
// WinUI's Mica fallback is: the software renderer draws every pixel opaque, so Mica could not
// show through. Light or dark follows the palette, so the colour scheme too.
global Look {
    out property <bool> dark: Palette.background.to-hsv().value < 0.5;
    // WinUI's SolidBackgroundFillColorBase.
    out property <color> window: self.dark ? #202020 : #f3f3f3;
    // A card, hovered and chosen, and its edge: WinUI's card fill and stroke as they come out
    // on the base.
    out property <color> card: self.dark ? #2b2b2b : #fbfbfb;
    out property <color> card-hover: self.dark ? #323232 : #f6f6f6;
    out property <color> card-selected: self.dark ? #383838 : #efefef;
    out property <color> card-stroke: self.dark ? #1d1d1d : #e5e5e5;
    // A navigation item hovered (WinUI's SubtleFillColorSecondary), and a little stronger, the
    // page shown.
    out property <color> subtle-hover: self.dark ? #ffffff0f : #0000000a;
    out property <color> subtle-selected: self.dark ? #ffffff15 : #0000000f;
    // TextFillColorSecondary: help text and details.
    out property <color> secondary-text: self.dark ? #ffffffc8 : #0000009e;
    out property <length> radius: 4px;
    // The width of a setting's control (ComboBox, slider, hotkey), and of the wide ones that
    // show font names or a form's text.
    out property <length> control-width: 240px;
    out property <length> wide-control-width: 280px;
    // A path's box, which has *Browse…* beside it.
    out property <length> path-width: 220px;
}

// A page of the navigation.
struct NavItem {
    text: string,
    icon: image,
}

export global SettingsState {
    // A page by its number (see `Pages`).
    in-out property <int> page;

    // General (SPEC §10.1)
    in-out property <bool> autostart;
    // Why the sign-in entry does not follow `autostart`; empty when it does.
    in property <string> autostart-error;
    in property <string> hotkey;
    // Set while the hotkey button waits for a combination; Rust reads the keys (they are
    // physical keys, which Slint's key events do not carry) and clears it.
    in-out property <bool> recording-hotkey;
    // Why the hotkey could not be registered or recorded; empty when it works.
    in property <string> hotkey-error;
    in-out property <int> hotkey-action;
    in-out property <bool> show-tray-icon;
    in-out property <bool> locked;
    in-out property <bool> popups-enabled;
    in-out property <int> clicks-when-locked;
    in-out property <float> sensor-spacing;
    // 0 = the picker, 1 = a submenu of types.
    in-out property <int> new-sensor-menu;

    // Bar (SPEC §10.2)
    // 0 = docked, 1 = floating.
    in-out property <int> mode;
    // Logical px.
    in-out property <float> floating-width;
    in-out property <int> edge;
    in property <[string]> monitors;
    in-out property <int> monitor;
    in-out property <bool> reserve-space;
    in-out property <int> z-order;
    in-out property <bool> hide-on-fullscreen;
    in-out property <bool> highlight-on-hover;
    in-out property <bool> shadow;
    // 0 = like Windows, 1 = on, 2 = off.
    in-out property <int> animations;
    in-out property <float> height;
    in property <int> theme-height;
    // The height differs from the theme default.
    in property <bool> height-customised;

    // Appearance (SPEC §10.3)
    // 0 = modern, 1 = classic.
    in-out property <int> theme;
    // 0 = like Windows, 1 = light, 2 = dark; also the window's own (SPEC §10.3).
    in-out property <int> color-scheme;
    // 0 = the theme's colour, 1 = a custom one.
    in-out property <int> background-mode;
    in-out property <string> background-color;
    in property <bool> background-color-customised;
    in property <string> background-color-default;
    in-out property <float> background-opacity;
    in property <bool> background-opacity-customised;
    in property <int> background-opacity-default;
    // "Theme default (…)", then the materials.
    in property <[string]> materials;
    in-out property <int> material;
    // Transparency effects are on in Windows, so a material can be shown.
    in property <bool> material-available: true;
    in property <[SkinTile]> skins;
    // The tile of the configured skin; -1 if it is not in the gallery.
    in property <int> skin-selected: -1;
    // The bar's height, which the previews have, logical px.
    in property <float> skin-preview-height: 25;
    // Why the configured skin is not drawn; empty when it is.
    in property <string> skin-notice;
    in-out property <string> custom-skin;
    in property <bool> custom-skin-shown;
    // Why the custom image cannot be used; empty when it can.
    in property <string> custom-skin-error;
    in property <[SkinPackRow]> skin-packs;
    // What the last install did, and whether it failed.
    in-out property <string> skin-install-message;
    in property <bool> skin-install-failed;

    // Sensors (SPEC §10.4)
    in-out property <string> sensor-text-color;
    // "Theme default (…)", then the installed families.
    in property <[string]> fonts;
    in-out property <int> sensor-font;
    // "Theme default (…)", then the six styles.
    in property <[string]> sensor-font-styles;
    in-out property <int> sensor-font-style;
    // 0 = fade, 1 = tint.
    in-out property <int> inactive-mode;
    in-out property <string> inactive-color;
    in-out property <float> inactive-opacity;

    // Popups (SPEC §10.5)
    in-out property <string> popup-background;
    in property <bool> popup-background-customised;
    in property <string> popup-background-default;
    in-out property <float> popup-opacity;
    in property <bool> popup-opacity-customised;
    in property <int> popup-opacity-default;
    in-out property <string> popup-text-color;
    in-out property <string> popup-strong-color;
    in-out property <int> popup-font;
    in property <[string]> popup-font-styles;
    in-out property <int> popup-font-style;
    in-out property <float> popup-font-size;
    in-out property <bool> popup-shadow;
    in-out property <float> show-delay;
    in-out property <float> hide-delay;

    // Applications (SPEC §10.6)
    in-out property <string> calendar-app;

    // The welcome page (SPEC §11.5): Modern and Classic with a preview of the bar.
    in property <[SkinTile]> welcome-themes;

    // A sensor's properties (SPEC §6.7)
    in property <[PropRow]> props;
    in property <string> props-title;
    in property <string> props-error;
    // No field holds an invalid value, so the form can be saved (SPEC §6.7).
    in property <bool> props-valid: true;

    // The Layout manager (SPEC §10.7)
    in property <[LayoutRow]> layout-rows;
    // The sensor whose Remove waits for confirmation.
    in-out property <string> layout-confirm;
    // A sensor just moved with its Up (or Down) button: the button takes the focus again once
    // the list shows the move, and the request is cleared.
    in-out property <string> layout-focus-id;
    in property <bool> layout-focus-up;

    // The sensor picker (SPEC §6.6)
    in property <[PickerRow]> picker-rows;
    in-out property <string> picker-search;
    // The selected type's `entry`; -1 for none.
    in-out property <int> picker-selected;
    // With a target sensor: 0 = insert before it, 1 = after it.
    in-out property <int> picker-after;
    // The target sensor's type name; empty without a target.
    in property <string> picker-target;

    // The last save error other than a hotkey error; empty when the last save worked.
    in property <string> save-error;

    // `path` is the dotted settings key, e.g. "bar.reserveSpace".
    callback set-flag(path: string, value: bool);
    callback set-choice(path: string, index: int);
    callback set-number(path: string, value: int);
    callback set-monitor(index: int);
    // A floating bar's width, logical px.
    callback set-floating-width(width: int);
    // Back to the theme default.
    callback reset(path: string);
    // A colour typed as #RRGGBB.
    callback set-color(path: string, text: string);
    // Index 0 is the theme default; then `fonts` or the font styles.
    callback set-font(path: string, index: int);
    callback set-font-style(path: string, index: int);
    // A text setting, saved as it is typed.
    callback set-text(path: string, text: string);
    // Index 0 is the theme default; then the materials.
    callback set-material(index: int);
    // The gallery's tile `index`.
    callback set-skin(index: int);
    callback browse-custom-skin();
    // Installs a skin pack from a folder, or else from a .zip file.
    callback install-skin(folder: bool);
    // Moves the pack `id` to the Recycle Bin.
    callback remove-skin(id: string);
    callback open-skins-folder();
    callback browse-calendar-app();

    // About (SPEC §10.7)
    in property <string> version;
    // Infodock's licence, the text of `LICENSE`.
    in property <string> licence;
    // The crates of the Windows build: "name version: licence".
    in property <[StandardListViewItem]> third-party;
    // The licence of the navigation's icons (Fluent UI System Icons).
    in property <string> icons-licence;
    callback open-logs-folder();
    // The welcome page's *Import layout…* (JSON or legacy XML) and *Get started*.
    callback welcome-import();
    callback welcome-done();
    // The colour of a #RRGGBB text, for swatches; transparent if it is not one.
    pure callback to-color(text: string) -> color;
    // The text is a colour as #RRGGBB.
    pure callback is-color(text: string) -> bool;

    // The navigation moved to another page (leaving the properties form cancels it).
    callback page-changed(page: int);
    // Edits in the properties form; each previews on the bar.
    callback prop-text(key: string, text: string);
    callback prop-flag(key: string, value: bool);
    callback prop-number(key: string, value: float);
    callback prop-choice(key: string, index: int);
    callback prop-color-mode(key: string, index: int, color: string);
    callback prop-browse(key: string);
    callback props-save();
    callback props-cancel();
    // Layout manager: one step up or down; a drop before line `boundary`.
    callback layout-move(id: string, up: bool);
    callback layout-drop(id: string, boundary: int);
    callback layout-edit(id: string);
    callback layout-remove(id: string);
    // Opens the picker for the end of zone `zone`.
    callback layout-add(zone: int);
    // The picker's search text changed.
    callback picker-searched(text: string);
    // Up (or Down) in the search box: the listed type above (or below) the selected one.
    callback picker-step(up: bool);
    // Adds the selected type and opens its properties.
    callback picker-add();
    callback picker-cancel();
}

// One setting as a card, laid out like Windows 11 Settings: label, help text and error on the
// left (they wrap), the control on the right.
component Row inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    in property <string> error;

    // The gap to the next card.
    padding-bottom: 4px;
    Rectangle {
        // Windows 11's cards, as WinUI's SettingsCard draws them.
        min-height: 68px;
        border-radius: Look.radius;
        border-width: 1px;
        border-color: Look.card-stroke;
        background: Look.card;

        line := HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 24px;

            VerticalLayout {
                width: line.width - line.padding-left - line.padding-right
                    - controls.preferred-width - line.spacing;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.label;
                    wrap: word-wrap;
                    // Wrapped text is measured at its own width (the layout would measure it at
                    // the row's width and leave too little height).
                    height: self.preferred-height;
                    color: Palette.foreground;
                }

                if root.help != "": Text {
                    text: root.help;
                    wrap: word-wrap;
                    height: self.preferred-height;
                    font-size: 12px;
                    color: Look.secondary-text;
                }
                if root.error != "": Text {
                    text: root.error;
                    wrap: word-wrap;
                    height: self.preferred-height;
                    font-size: 12px;
                    color: #d13438;
                }
            }

            controls := VerticalLayout {
                alignment: center;
                @children
            }
        }
    }
}

// A slider with its value and unit shown next to it, saved when released. `unit` is a message
// key with a `{value}` placeholder, e.g. "common.px". Dragging moves in any amount, so the value
// is shown rounded to `step` and snaps to it on release: what is shown is what is saved.
component ValueSlider inherits HorizontalLayout {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in property <string> unit: "common.px";
    in-out property <float> value;
    callback released(value: int);

    function stepped(v: float) -> int {
        return Math.round(v / root.step) * root.step;
    }

    // As wide as the other controls, the value on its left as Windows 11 shows it.
    width: Look.control-width;
    spacing: 8px;
    Text {
        width: 64px;
        vertical-alignment: center;
        horizontal-alignment: right;
        text: I18n.tr-with(root.unit, "value", root.stepped(root.value));
        color: Look.secondary-text;
    }

    Slider {
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        value <=> root.value;
        accessible-label: root.label;
        released(v) => {
            root.value = root.stepped(v);
            root.released(root.value);
        }
    }
}

// A switch with its state written on its left, "On" or "Off", as Windows 11 Settings shows it.
// `label` is the switch's accessible name; the text is only shown, the switch reports its state.
component OnOffSwitch inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked;
    callback toggled;

    spacing: 12px;
    Text {
        vertical-alignment: center;
        horizontal-alignment: right;
        text: root.checked ? I18n.tr("common.on") : I18n.tr("common.off");
        color: Palette.foreground;
        accessible-role: none;
    }

    Switch {
        checked <=> root.checked;
        accessible-label: root.label;
        toggled => {
            root.toggled();
        }
    }
}

// A colour as #RRGGBB with a swatch. It is accepted as soon as the typed text is a colour, so
// a click that does not take the focus (Save, the navigation) finds it saved; on Enter or when
// the field loses focus it is accepted whatever it is, and an invalid one shows an error. With
// `every-edit` (the properties form, which validates as it goes) every edit is accepted.
component ColorField inherits HorizontalLayout {
    in property <string> label;
    in property <bool> every-edit;
    in-out property <string> value;
    callback accepted(text: string);

    spacing: 8px;
    alignment: end;
    Rectangle {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Palette.border;
        background: SettingsState.to-color(root.value);
    }

    edit := LineEdit {
        width: 120px;
        text <=> root.value;
        accessible-label: root.label;
        edited(text) => {
            if root.every-edit || SettingsState.is-color(text) {
                root.accepted(text);
            }
        }
        accepted(text) => {
            root.accepted(text);
        }
        changed has-focus => {
            if !self.has-focus {
                root.accepted(self.text);
            }
        }
    }
}

// The control of a setting whose default comes from the theme, with a button back to it.
component WithReset inherits VerticalLayout {
    in property <bool> customised;
    callback reset();

    spacing: 8px;
    @children
    HorizontalLayout {
        alignment: end;
        Button {
            text: I18n.tr("settings.reset");
            enabled: root.customised;
            clicked => {
                root.reset();
            }
        }
    }
}

component GeneralPage inherits VerticalLayout {
    alignment: start;

    Row {
        label: I18n.tr("settings.general.autostart");
        help: I18n.tr("settings.general.autostart.help");
        error: SettingsState.autostart-error;
        OnOffSwitch {
            checked <=> SettingsState.autostart;
            label: I18n.tr("settings.general.autostart");
            toggled => {
                SettingsState.set-flag("autostart", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.hotkey");
        help: I18n.tr("settings.general.hotkey.help");
        error: SettingsState.hotkey-error;
        Button {
            width: Look.control-width;
            text: SettingsState.recording-hotkey ? I18n.tr("settings.general.hotkey.recording") : SettingsState.hotkey;
            primary: SettingsState.recording-hotkey;
            accessible-label: I18n.tr("settings.general.hotkey");
            clicked => {
                SettingsState.recording-hotkey = !SettingsState.recording-hotkey;
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.hotkeyAction");
        ComboBox {
            width: Look.control-width;
            model: [
                I18n.tr("settings.general.hotkeyAction.bringToFront"),
                I18n.tr("settings.general.hotkeyAction.toggleVisibility"),
            ];
            current-index <=> SettingsState.hotkey-action;
            accessible-label: I18n.tr("settings.general.hotkeyAction");
            selected => {
                SettingsState.set-choice("hotkeyAction", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.showTrayIcon");
        OnOffSwitch {
            checked <=> SettingsState.show-tray-icon;
            label: I18n.tr("settings.general.showTrayIcon");
            toggled => {
                SettingsState.set-flag("showTrayIcon", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.locked");
        help: I18n.tr("settings.general.locked.help");
        OnOffSwitch {
            checked <=> SettingsState.locked;
            label: I18n.tr("settings.general.locked");
            toggled => {
                SettingsState.set-flag("locked", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.popupsEnabled");
        OnOffSwitch {
            checked <=> SettingsState.popups-enabled;
            label: I18n.tr("settings.general.popupsEnabled");
            toggled => {
                SettingsState.set-flag("popupsEnabled", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.clicksWhenLocked");
        ComboBox {
            width: Look.control-width;
            model: [
                I18n.tr("settings.general.clicksWhenLocked.always"),
                I18n.tr("settings.general.clicksWhenLocked.altOnly"),
            ];
            current-index <=> SettingsState.clicks-when-locked;
            accessible-label: I18n.tr("settings.general.clicksWhenLocked");
            selected => {
                SettingsState.set-choice("clicksWhenLocked", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.sensorSpacing");
        ValueSlider {
            label: I18n.tr("settings.general.sensorSpacing");
            minimum: 1;
            maximum: 20;
            value <=> SettingsState.sensor-spacing;
            released(v) => {
                SettingsState.set-number("sensorSpacing", v);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.newSensorMenu");
        help: I18n.tr("settings.general.newSensorMenu.help");
        ComboBox {
            width: Look.control-width;
            model: [
                I18n.tr("settings.general.newSensorMenu.dialog"),
                I18n.tr("settings.general.newSensorMenu.submenu"),
            ];
            current-index <=> SettingsState.new-sensor-menu;
            accessible-label: I18n.tr("settings.general.newSensorMenu");
            selected => {
                SettingsState.set-choice("newSensorMenu", self.current-index);
            }
        }
    }
}

component BarPage inherits VerticalLayout {
    alignment: start;

    Row {
        label: I18n.tr("settings.bar.mode");
        help: I18n.tr("settings.bar.mode.help");
        ComboBox {
            width: Look.control-width;
            model: [I18n.tr("settings.bar.mode.docked"), I18n.tr("settings.bar.mode.floating")];
            current-index <=> SettingsState.mode;
            accessible-label: I18n.tr("settings.bar.mode");
            selected => {
                SettingsState.set-choice("bar.mode", self.current-index);
            }
        }
    }

    if SettingsState.mode == 1: Row {
        label: I18n.tr("settings.bar.width");
        ValueSlider {
            label: I18n.tr("settings.bar.width");
            minimum: 200;
            maximum: 3840;
            step: 10;
            value <=> SettingsState.floating-width;
            released(v) => {
                SettingsState.set-floating-width(v);
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.edge");
        ComboBox {
            width: Look.control-width;
            model: [I18n.tr("settings.bar.edge.top"), I18n.tr("settings.bar.edge.bottom")];
            current-index <=> SettingsState.edge;
            accessible-label: I18n.tr("settings.bar.edge");
            selected => {
                SettingsState.set-choice("bar.edge", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.monitor");
        ComboBox {
            width: Look.control-width;
            model: SettingsState.monitors;
            current-index <=> SettingsState.monitor;
            accessible-label: I18n.tr("settings.bar.monitor");
            selected => {
                SettingsState.set-monitor(self.current-index);
            }
        }
    }

    if SettingsState.mode == 0: Row {
        label: I18n.tr("settings.bar.reserveSpace");
        help: I18n.tr("settings.bar.reserveSpace.help");
        OnOffSwitch {
            checked <=> SettingsState.reserve-space;
            label: I18n.tr("settings.bar.reserveSpace");
            toggled => {
                SettingsState.set-flag("bar.reserveSpace", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.zOrder");
        help: I18n.tr("settings.bar.zOrder.help");
        ComboBox {
            width: Look.control-width;
            model: [
                I18n.tr("settings.bar.zOrder.topmost"),
                I18n.tr("settings.bar.zOrder.normal"),
                I18n.tr("settings.bar.zOrder.bottom"),
            ];
            current-index <=> SettingsState.z-order;
            accessible-label: I18n.tr("settings.bar.zOrder");
            selected => {
                SettingsState.set-choice("bar.zOrder", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.hideOnFullscreen");
        OnOffSwitch {
            checked <=> SettingsState.hide-on-fullscreen;
            label: I18n.tr("settings.bar.hideOnFullscreen");
            toggled => {
                SettingsState.set-flag("bar.hideOnFullscreen", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.height");
        help: I18n.tr-with("settings.bar.height.help", "height", SettingsState.theme-height);
        VerticalLayout {
            spacing: 8px;
            ValueSlider {
                label: I18n.tr("settings.bar.height");
                minimum: 22;
                maximum: 40;
                value <=> SettingsState.height;
                released(v) => {
                    SettingsState.set-number("bar.height", v);
                }
            }

            HorizontalLayout {
                alignment: end;
                Button {
                    text: I18n.tr("settings.reset");
                    enabled: SettingsState.height-customised;
                    clicked => {
                        SettingsState.reset("bar.height");
                    }
                }
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.highlightOnHover");
        help: I18n.tr("settings.bar.highlightOnHover.help");
        OnOffSwitch {
            checked <=> SettingsState.highlight-on-hover;
            label: I18n.tr("settings.bar.highlightOnHover");
            toggled => {
                SettingsState.set-flag("bar.highlightOnHover", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.shadow");
        help: I18n.tr("settings.bar.shadow.help");
        OnOffSwitch {
            checked <=> SettingsState.shadow;
            label: I18n.tr("settings.bar.shadow");
            toggled => {
                SettingsState.set-flag("bar.shadow", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.bar.animations");
        help: I18n.tr("settings.bar.animations.help");
        ComboBox {
            width: Look.control-width;
            model: [
                I18n.tr("settings.bar.animations.auto"),
                I18n.tr("settings.bar.animations.on"),
                I18n.tr("settings.bar.animations.off"),
            ];
            current-index <=> SettingsState.animations;
            accessible-label: I18n.tr("settings.bar.animations");
            selected => {
                SettingsState.set-choice("bar.animations", self.current-index);
            }
        }
    }
}

// A heading for a group of settings on a page, above its cards (Windows 11's Body Strong).
component SectionHeading inherits VerticalLayout {
    in property <string> title;
    in property <string> help;
    spacing: 2px;
    padding-bottom: 4px;
    Text {
        text: root.title;
        font-size: 14px;
        font-weight: 600;
        color: Palette.foreground;
        accessible-role: text;
    }

    if root.help != "": Text {
        text: root.help;
        wrap: word-wrap;
        font-size: 12px;
        color: Look.secondary-text;
    }
}

// An icon-only button.
component IconButton inherits Button {
    in property <string> label;
    colorize-icon: true;
    icon-size: 16px;
    accessible-label: self.label;
}

// The Layout manager (SPEC §10.7): each zone's sensors, which move by dragging or with the
// arrow buttons. All lines are equally tall, so a pointer position maps to a line boundary.
component LayoutList inherits Rectangle {
    property <length> line-height: 44px;
    // The sensor being dragged, and the line boundary it would drop at (-1: none).
    property <string> drag-id;
    property <int> drop-at: -1;

    height: SettingsState.layout-rows.length * self.line-height;
    accessible-role: list;
    accessible-label: I18n.tr("settings.layout.title");

    for row[i] in SettingsState.layout-rows: Rectangle {
        x: 0;
        y: i * root.line-height;
        width: parent.width;
        height: root.line-height;

        if row.kind == LineKinds.heading: HorizontalLayout {
            padding-top: 8px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: row.name;
                font-weight: 600;
                vertical-alignment: center;
                color: Palette.foreground;
            }

            Button {
                horizontal-stretch: 0;
                text: I18n.tr("settings.layout.add");
                icon: @image-url("icons/add.svg");
                colorize-icon: true;
                icon-size: 16px;
                accessible-label: I18n.tr-with("settings.layout.addTo", "zone", row.name);
                clicked => {
                    SettingsState.layout-add(row.zone);
                }
            }
        }

        if row.kind == LineKinds.empty: Text {
            x: 16px;
            text: row.name;
            vertical-alignment: center;
            color: Look.secondary-text;
        }

        if row.kind == LineKinds.sensor: line := Rectangle {
            // What screen readers call it, in its row's buttons too.
            property <string> named: row.detail == "" ? row.name : row.name + ", " + row.detail;
            // A card, with the gap to the next one inside the line.
            y: 2px;
            height: parent.height - 4px;
            border-radius: Look.radius;
            border-width: 1px;
            border-color: Look.card-stroke;
            // Dimmed while dragged, like on the bar (SPEC §6.2).
            background: touch.has-hover || root.drag-id == row.id ? Look.card-hover : Look.card;
            opacity: root.drag-id == row.id ? 0.6 : 1;
            accessible-role: list-item;
            accessible-label: self.named;
            accessible-item-index: row.index;
            accessible-item-count: row.count;

            touch := TouchArea {
                mouse-cursor: root.drag-id == row.id ? MouseCursor.grabbing : MouseCursor.grab;
                moved => {
                    if root.drag-id == row.id || abs(self.mouse-x - self.pressed-x) > 4px
                        || abs(self.mouse-y - self.pressed-y) > 4px {
                        root.drag-id = row.id;
                        // Outside the list sideways: no drop.
                        root.drop-at = self.mouse-x < 0 || self.mouse-x > self.width ? -1
                            : max(0, min(SettingsState.layout-rows.length,
                                round((i * root.line-height + self.mouse-y) / root.line-height)));
                    }
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                        if event.kind == PointerEventKind.up && root.drag-id != "" && root.drop-at >= 0 {
                            SettingsState.layout-drop(root.drag-id, root.drop-at);
                        }
                        root.drag-id = "";
                        root.drop-at = -1;
                    }
                }
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 4px;
                spacing: 4px;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: row.name;
                        overflow: elide;
                        color: Palette.foreground;
                    }

                    if row.detail != "": Text {
                        text: row.detail;
                        overflow: elide;
                        font-size: 12px;
                        color: Look.secondary-text;
                    }
                }

                if SettingsState.layout-confirm == row.id: HorizontalLayout {
                    spacing: 4px;
                    alignment: end;
                    Text {
                        text: I18n.tr-with("menu.remove.confirm", "name", row.name);
                        vertical-alignment: center;
                        overflow: elide;
                        color: Palette.foreground;
                    }

                    Button {
                        text: I18n.tr("menu.remove.action");
                        primary: true;
                        clicked => {
                            SettingsState.layout-confirm = "";
                            SettingsState.layout-remove(row.id);
                        }
                    }

                    Button {
                        text: I18n.tr("settings.layout.cancel");
                        clicked => {
                            SettingsState.layout-confirm = "";
                        }
                    }
                }

                if SettingsState.layout-confirm != row.id: HorizontalLayout {
                    spacing: 4px;
                    alignment: end;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    // The list is rebuilt after a move, so keyboard users find their button
                    // again on the moved sensor (the other one where the list ends).
                    init => {
                        if SettingsState.layout-focus-id == row.id {
                            SettingsState.layout-focus-id = "";
                            if (SettingsState.layout-focus-up && row.up) || !row.down {
                                up.focus();
                            } else {
                                down.focus();
                            }
                        }
                    }

                    up := IconButton {
                        label: I18n.tr-with("settings.layout.upNamed", "name", line.named);
                        icon: @image-url("icons/up.svg");
                        enabled: row.up;
                        clicked => {
                            SettingsState.layout-move(row.id, true);
                        }
                    }

                    down := IconButton {
                        label: I18n.tr-with("settings.layout.downNamed", "name", line.named);
                        icon: @image-url("icons/down.svg");
                        enabled: row.down;
                        clicked => {
                            SettingsState.layout-move(row.id, false);
                        }
                    }

                    IconButton {
                        label: I18n.tr-with("settings.layout.editNamed", "name", line.named);
                        icon: @image-url("icons/edit.svg");
                        enabled: row.editable;
                        clicked => {
                            SettingsState.layout-edit(row.id);
                        }
                    }

                    IconButton {
                        label: I18n.tr-with("settings.layout.removeNamed", "name", line.named);
                        icon: @image-url("icons/remove.svg");
                        clicked => {
                            SettingsState.layout-confirm = row.id;
                        }
                    }
                }
            }
        }
    }

    if root.drop-at >= 0: Rectangle {
        x: 0;
        y: root.drop-at * root.line-height - 1px;
        width: parent.width;
        height: 2px;
        background: Palette.accent-background;
    }
}

// The classic skins as tiles with their previews (SPEC §12.4), in as many columns as fit. A
// click chooses one; with the focus, the arrow keys move to the previous or next.
component SkinGallery inherits FocusScope {
    property <length> tile-width: 172px;
    property <length> tile-height: SettingsState.skin-preview-height * 1px + 44px;
    property <length> gap: 8px;
    property <int> columns: max(1, floor((self.width + self.gap) / (self.tile-width + self.gap)));

    height: ceil(SettingsState.skins.length / self.columns) * (self.tile-height + self.gap);
    accessible-role: list;
    accessible-label: I18n.tr("settings.appearance.skin");
    // The chosen skin, read with the list and again when the arrow keys change it.
    accessible-value: SettingsState.skin-selected >= 0
        && SettingsState.skin-selected < SettingsState.skins.length
        ? SettingsState.skins[SettingsState.skin-selected].name : "";
    key-pressed(event) => {
        if event.text == Key.LeftArrow || event.text == Key.UpArrow {
            if SettingsState.skin-selected > 0 {
                SettingsState.set-skin(SettingsState.skin-selected - 1);
            }
            return accept;
        }
        if event.text == Key.RightArrow || event.text == Key.DownArrow {
            if SettingsState.skin-selected < SettingsState.skins.length - 1 {
                SettingsState.set-skin(SettingsState.skin-selected + 1);
            }
            return accept;
        }
        reject
    }

    for tile[i] in SettingsState.skins: Rectangle {
        x: mod(i, root.columns) * (root.tile-width + root.gap);
        y: floor(i / root.columns) * (root.tile-height + root.gap);
        width: root.tile-width;
        height: root.tile-height;
        border-radius: 6px;
        border-width: tile.selected ? 2px : 1px;
        border-color: tile.selected ? (root.has-focus ? Palette.foreground : Palette.accent-background)
            : Look.card-stroke;
        background: touch.has-hover ? Look.card-hover : Look.card;
        accessible-role: list-item;
        accessible-label: tile.name;
        accessible-item-selectable: true;
        accessible-item-selected: tile.selected;
        accessible-item-index: i;
        accessible-item-count: SettingsState.skins.length;
        accessible-action-default => {
            SettingsState.set-skin(i);
        }

        touch := TouchArea {
            clicked => {
                root.focus();
                SettingsState.set-skin(i);
            }
        }

        VerticalLayout {
            padding: 6px;
            spacing: 6px;
            alignment: start;
            if tile.has-preview: Image {
                width: 160px;
                height: SettingsState.skin-preview-height * 1px;
                source: tile.preview;
                image-fit: fill;
            }
            if !tile.has-preview: Rectangle {
                width: 160px;
                height: SettingsState.skin-preview-height * 1px;
                background: tile.swatch;
            }
            Text {
                text: tile.name;
                overflow: elide;
                horizontal-alignment: center;
                color: Palette.foreground;
            }
        }
    }
}

component AppearancePage inherits VerticalLayout {
    alignment: start;

    Row {
        label: I18n.tr("settings.appearance.theme");
        help: I18n.tr("settings.appearance.theme.help");
        ComboBox {
            width: Look.control-width;
            model: [
                I18n.tr("settings.appearance.theme.modern"),
                I18n.tr("settings.appearance.theme.classic"),
            ];
            current-index <=> SettingsState.theme;
            accessible-label: I18n.tr("settings.appearance.theme");
            selected => {
                SettingsState.set-choice("theme", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.appearance.colorScheme");
        help: I18n.tr("settings.appearance.colorScheme.help");
        ComboBox {
            width: Look.control-width;
            model: [
                I18n.tr("settings.appearance.colorScheme.system"),
                I18n.tr("settings.appearance.colorScheme.light"),
                I18n.tr("settings.appearance.colorScheme.dark"),
            ];
            current-index <=> SettingsState.color-scheme;
            accessible-label: I18n.tr("settings.appearance.colorScheme");
            selected => {
                SettingsState.set-choice("colorScheme", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.appearance.colorMode");
        help: SettingsState.theme == 1 ? I18n.tr("settings.appearance.colorMode.classicHelp") : "";
        ComboBox {
            width: Look.control-width;
            model: [
                I18n.tr("settings.appearance.colorMode.standard"),
                I18n.tr("settings.appearance.colorMode.custom"),
            ];
            current-index <=> SettingsState.background-mode;
            accessible-label: I18n.tr("settings.appearance.colorMode");
            selected => {
                SettingsState.set-choice("background.colorMode", self.current-index);
            }
        }
    }

    if SettingsState.background-mode == 1: Row {
        label: I18n.tr("settings.appearance.color");
        help: I18n.tr-with("settings.popups.default", "value", SettingsState.background-color-default);
        WithReset {
            customised: SettingsState.background-color-customised;
            reset => {
                SettingsState.reset("background.color");
            }
            ColorField {
                label: I18n.tr("settings.appearance.color");
                value <=> SettingsState.background-color;
                accepted(text) => {
                    SettingsState.set-color("background.color", text);
                }
            }
        }
    }

    Row {
        label: I18n.tr("settings.appearance.opacity");
        help: SettingsState.theme == 1
            ? I18n.tr-with("settings.appearance.opacity.classicHelp", "value", SettingsState.background-opacity-default)
            : I18n.tr-with("settings.popups.opacity.default", "value", SettingsState.background-opacity-default);
        WithReset {
            customised: SettingsState.background-opacity-customised;
            reset => {
                SettingsState.reset("background.opacity");
            }
            ValueSlider {
                label: I18n.tr("settings.appearance.opacity");
                minimum: 0;
                maximum: 100;
                unit: "common.percent";
                value <=> SettingsState.background-opacity;
                released(v) => {
                    SettingsState.set-number("background.opacity", v);
                }
            }
        }
    }

    Row {
        label: I18n.tr("settings.appearance.material");
        help: SettingsState.material-available ? I18n.tr("settings.appearance.material.help")
            : I18n.tr("settings.appearance.material.off");
        ComboBox {
            width: Look.control-width;
            model: SettingsState.materials;
            current-index <=> SettingsState.material;
            enabled: SettingsState.material-available;
            accessible-label: I18n.tr("settings.appearance.material");
            selected => {
                SettingsState.set-material(self.current-index);
            }
        }
    }

    if SettingsState.theme == 1: SectionHeading {
        padding-top: 24px;
        padding-bottom: 12px;
        title: I18n.tr("settings.appearance.skin");
        help: I18n.tr("settings.appearance.skin.help");
    }

    if SettingsState.theme == 1 && SettingsState.skin-notice != "": Text {
        text: SettingsState.skin-notice;
        wrap: word-wrap;
        color: #d13438;
    }

    if SettingsState.theme == 1: VerticalLayout {
        padding-top: 4px;
        SkinGallery { }
    }

    if SettingsState.theme == 1 && SettingsState.custom-skin-shown: Row {
        label: I18n.tr("settings.appearance.customSkin");
        help: I18n.tr("settings.appearance.customSkin.help");
        error: SettingsState.custom-skin-error;
        HorizontalLayout {
            spacing: 8px;
            // Saved as it is typed: the navigation does not take the focus.
            LineEdit {
                width: Look.path-width;
                text <=> SettingsState.custom-skin;
                accessible-label: I18n.tr("settings.appearance.customSkin");
                edited(text) => {
                    SettingsState.set-text("classic.customSkin", text);
                }
            }
            Button {
                text: I18n.tr("settings.props.browse");
                clicked => {
                    SettingsState.browse-custom-skin();
                }
            }
        }
    }

    if SettingsState.theme == 1: SectionHeading {
        padding-top: 24px;
        padding-bottom: 8px;
        title: I18n.tr("settings.appearance.packs");
        help: I18n.tr("settings.appearance.packs.help");
    }

    if SettingsState.theme == 1: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Button {
            text: I18n.tr("settings.appearance.packs.installFolder");
            clicked => {
                SettingsState.install-skin(true);
            }
        }

        Button {
            text: I18n.tr("settings.appearance.packs.installZip");
            clicked => {
                SettingsState.install-skin(false);
            }
        }

        Button {
            text: I18n.tr("settings.appearance.packs.openFolder");
            clicked => {
                SettingsState.open-skins-folder();
            }
        }
    }

    if SettingsState.theme == 1 && SettingsState.skin-install-message != "": Text {
        text: SettingsState.skin-install-message;
        wrap: word-wrap;
        color: SettingsState.skin-install-failed ? #d13438 : Palette.foreground;
    }

    if SettingsState.theme == 1 && SettingsState.skin-packs.length == 0: Text {
        text: I18n.tr("settings.appearance.packs.none");
        wrap: word-wrap;
        color: Look.secondary-text;
    }

    if SettingsState.theme == 1: VerticalLayout {
        for pack in SettingsState.skin-packs: Row {
            label: pack.name;
            error: pack.problem;
            Button {
                text: I18n.tr("settings.appearance.packs.remove");
                accessible-label: I18n.tr-with("settings.appearance.packs.removeNamed", "name", pack.name);
                clicked => {
                    SettingsState.remove-skin(pack.id);
                }
            }
        }
    }
}

