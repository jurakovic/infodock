// The properties form, generated from the sensor type's schema (SPEC §6.7).
component PropertiesPage inherits VerticalLayout {
    alignment: start;

    if SettingsState.props-error != "": Text {
        text: SettingsState.props-error;
        wrap: word-wrap;
        color: #d13438;
    }

    if SettingsState.props.length == 0: Text {
        text: I18n.tr("settings.props.noFields");
        wrap: word-wrap;
        color: Palette.foreground;
    }

    for row in SettingsState.props: VerticalLayout {
        if row.visible: Row {
            label: row.label;
            help: row.help;
            error: row.error;

            if row.kind == 0: LineEdit {
                width: 280px;
                text: row.text;
                accessible-label: row.label;
                edited(text) => {
                    SettingsState.prop-text(row.key, text);
                }
            }
            if row.kind == 1: Switch {
                checked: row.checked;
                accessible-label: row.label;
                toggled => {
                    SettingsState.prop-flag(row.key, self.checked);
                }
            }
            if row.kind == 2: ComboBox {
                width: 280px;
                model: row.options;
                current-index: row.index;
                accessible-label: row.label;
                selected => {
                    SettingsState.prop-choice(row.key, self.current-index);
                }
            }
            if row.kind == 3: ValueSlider {
                label: row.label;
                minimum: row.minimum;
                maximum: row.maximum;
                step: row.step;
                unit: row.unit;
                value: row.number;
                released(v) => {
                    SettingsState.prop-number(row.key, v);
                }
            }
            if row.kind == 4: ColorField {
                label: row.label;
                every-edit: true;
                value: row.text;
                accepted(text) => {
                    SettingsState.prop-text(row.key, text);
                }
            }
            if row.kind == 5: VerticalLayout {
                spacing: 8px;
                ComboBox {
                    width: 280px;
                    model: row.options;
                    current-index: row.index;
                    accessible-label: row.label;
                    selected => {
                        SettingsState.prop-color-mode(row.key, self.current-index, row.color);
                    }
                }
                // Custom: the colour.
                if row.index == 1: ColorField {
                    label: row.label;
                    every-edit: true;
                    value: row.color;
                    accepted(text) => {
                        SettingsState.prop-color-mode(row.key, row.index, text);
                    }
                }
            }
            if row.kind == 6 || row.kind == 7: HorizontalLayout {
                spacing: 8px;
                // Every edit counts, as in a text row: clicking Save does not take the focus, so
                // the box cannot wait for focus-out.
                LineEdit {
                    width: 280px;
                    text: row.text;
                    accessible-label: row.label;
                    edited(text) => {
                        SettingsState.prop-text(row.key, text);
                    }
                }
                Button {
                    text: I18n.tr("settings.props.browse");
                    clicked => {
                        SettingsState.prop-browse(row.key);
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        padding-top: 16px;
        Button {
            text: I18n.tr("settings.props.cancel");
            clicked => {
                SettingsState.props-cancel();
            }
        }

        Button {
            text: I18n.tr("settings.props.save");
            primary: true;
            enabled: SettingsState.props-valid;
            clicked => {
                SettingsState.props-save();
            }
        }
    }
}

// The sensor picker (SPEC §6.6): types by category, a search box, and for a target sensor
// where to insert.
component PickerPage inherits VerticalLayout {
    alignment: start;
    spacing: 8px;

    // Up and Down move the selection while the search box keeps the focus (SPEC §6.6).
    FocusScope {
        enabled: false;
        capture-key-pressed(event) => {
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                SettingsState.picker-step(event.text == Key.UpArrow);
                return accept;
            }
            reject
        }

        LineEdit {
            placeholder-text: I18n.tr("settings.picker.search");
            text <=> SettingsState.picker-search;
            accessible-label: I18n.tr("settings.picker.search");
            init => {
                self.focus();
            }
            edited(text) => {
                SettingsState.picker-searched(text);
            }
            accepted => {
                if SettingsState.picker-selected >= 0 {
                    SettingsState.picker-add();
                }
            }
        }
    }

    if SettingsState.picker-target != "": HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text {
            text: I18n.tr("settings.picker.insert");
            vertical-alignment: center;
            color: Palette.foreground;
        }

        ComboBox {
            width: 120px;
            model: [I18n.tr("settings.picker.before"), I18n.tr("settings.picker.after")];
            current-index <=> SettingsState.picker-after;
            accessible-label: I18n.tr("settings.picker.insert");
        }

        Text {
            text: I18n.tr-with("settings.picker.target", "name", SettingsState.picker-target);
            vertical-alignment: center;
            wrap: word-wrap;
            color: Palette.foreground;
        }
    }

    if SettingsState.picker-rows.length == 0: Text {
        text: I18n.tr("settings.picker.none");
        wrap: word-wrap;
        color: Palette.foreground;
    }

    VerticalLayout {
        for row in SettingsState.picker-rows: VerticalLayout {
            if row.heading: Text {
                text: row.name;
                font-weight: 600;
                color: Palette.foreground;
                accessible-role: text;
            }
            if !row.heading: item := Rectangle {
                property <bool> selected: SettingsState.picker-selected == row.entry;
                border-radius: 4px;
                background: self.selected ? Palette.selection-background
                    : touch.has-hover ? Palette.alternate-background : transparent;
                accessible-role: list-item;
                accessible-label: row.name;
                accessible-description: row.description;
                accessible-item-selectable: true;
                accessible-item-selected: self.selected;
                accessible-action-default => {
                    SettingsState.picker-selected = row.entry;
                }

                touch := TouchArea {
                    clicked => {
                        SettingsState.picker-selected = row.entry;
                    }
                    double-clicked => {
                        SettingsState.picker-selected = row.entry;
                        SettingsState.picker-add();
                    }
                }

                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    Text {
                        text: row.name;
                        color: item.selected ? Palette.selection-foreground : Palette.foreground;
                    }

                    Text {
                        text: row.description;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: item.selected ? Palette.selection-foreground : Palette.foreground;
                        opacity: 0.7;
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        padding-top: 16px;
        Button {
            text: I18n.tr("settings.picker.cancel");
            clicked => {
                SettingsState.picker-cancel();
            }
        }

        Button {
            text: I18n.tr("settings.picker.add");
            primary: true;
            enabled: SettingsState.picker-selected >= 0;
            clicked => {
                SettingsState.picker-add();
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: I18n.tr("settings.title");
    icon: @image-url("../icons/32x32.png");
    preferred-width: 760px;
    preferred-height: 560px;
    min-width: 560px;
    min-height: 420px;
    background: Palette.background;
    // The page last shown, to go back to when the navigation is left without a selection.
    property <int> shown-page: 0;

    HorizontalLayout {
        VerticalLayout {
            width: 180px;
            padding: 8px;
            StandardListView {
                model: [
                    { text: I18n.tr("settings.nav.general") },
                    { text: I18n.tr("settings.nav.bar") },
                    { text: I18n.tr("settings.nav.sensors") },
                    { text: I18n.tr("settings.nav.popups") },
                ];
                current-item <=> SettingsState.page;
                accessible-label: I18n.tr("settings.nav.label");
                changed current-item => {
                    // Ctrl+Space unselects the current item; the page stays.
                    if self.current-item < 0 {
                        self.current-item = root.shown-page;
                    } else if self.current-item != root.shown-page {
                        root.shown-page = self.current-item;
                        SettingsState.page-changed(self.current-item);
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Palette.border;
        }

        VerticalLayout {
            padding-left: 24px;
            padding-top: 16px;
            spacing: 8px;

            Text {
                text: SettingsState.page == 4 ? SettingsState.props-title
                    : SettingsState.page == 5 ? I18n.tr("settings.picker.title") : [
                    I18n.tr("settings.nav.general"),
                    I18n.tr("settings.nav.bar"),
                    I18n.tr("settings.nav.sensors"),
                    I18n.tr("settings.nav.popups"),
                ][SettingsState.page];
                font-size: 20px;
                font-weight: 600;
                color: Palette.foreground;
            }

            if SettingsState.save-error != "": Text {
                text: I18n.tr-with("settings.saveError", "error", SettingsState.save-error);
                wrap: word-wrap;
                color: #d13438;
            }

            scroll := ScrollView {
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: content.preferred-height;
                content := VerticalLayout {
                    width: scroll.visible-width - 20px;
                    padding-bottom: 24px;
                    if SettingsState.page == 0: GeneralPage { }
                    if SettingsState.page == 1: BarPage { }
                    if SettingsState.page == 2: SensorsPage { }
                    if SettingsState.page == 3: PopupsPage { }
                    if SettingsState.page == 4: PropertiesPage { }
                    if SettingsState.page == 5: PickerPage { }
                }
            }
        }
    }
}
