// The welcome page's theme choice (SPEC §11.5): a tile per theme with a preview of the bar, chosen
// by a click or, once it has the focus, the arrow keys.
component ThemeChoice inherits FocusScope {
    height: tiles.preferred-height;
    accessible-role: list;
    accessible-label: I18n.tr("settings.appearance.theme");
    key-pressed(event) => {
        if (event.text == Key.LeftArrow || event.text == Key.UpArrow) && SettingsState.theme > 0 {
            SettingsState.set-choice("theme", SettingsState.theme - 1);
            return accept;
        }
        if (event.text == Key.RightArrow || event.text == Key.DownArrow)
            && SettingsState.theme < SettingsState.welcome-themes.length - 1 {
            SettingsState.set-choice("theme", SettingsState.theme + 1);
            return accept;
        }
        reject
    }

    tiles := HorizontalLayout {
        alignment: start;
        spacing: 12px;
        for tile[i] in SettingsState.welcome-themes: Rectangle {
            width: 252px;
            height: content.preferred-height;
            border-radius: 6px;
            border-width: tile.selected ? 2px : 1px;
            border-color: tile.selected ? (root.has-focus ? Palette.foreground : Palette.accent-background)
                : Palette.border;
            background: touch.has-hover ? Palette.alternate-background : transparent;
            accessible-role: list-item;
            accessible-label: tile.name;
            accessible-item-selectable: true;
            accessible-item-selected: tile.selected;
            accessible-action-default => {
                SettingsState.set-choice("theme", i);
            }

            touch := TouchArea {
                clicked => {
                    root.focus();
                    SettingsState.set-choice("theme", i);
                }
            }

            content := VerticalLayout {
                padding: 6px;
                spacing: 6px;
                // At the bar's own height (physical px of the preview).
                if tile.has-preview: Image {
                    width: 240px;
                    height: tile.preview.height * 1phx;
                    source: tile.preview;
                    image-fit: fill;
                }
                if !tile.has-preview: Rectangle {
                    width: 240px;
                    height: 28px;
                    background: tile.swatch;
                }
                Text {
                    text: tile.name;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }
            }
        }
    }
}

// A tip on the welcome page.
component Tip inherits HorizontalLayout {
    in property <string> text;
    spacing: 8px;
    Text {
        text: "•";
        horizontal-stretch: 0;
        color: Palette.foreground;
    }

    Text {
        text: root.text;
        horizontal-stretch: 1;
        wrap: word-wrap;
        height: self.preferred-height;
        color: Palette.foreground;
    }
}

// Shown once, on first run (SPEC §11.5): how the bar looks, where it sits, starting with Windows,
// a layout to bring along, and how to get going.
component WelcomePage inherits VerticalLayout {
    alignment: start;

    Text {
        text: I18n.tr("welcome.intro");
        wrap: word-wrap;
        height: self.preferred-height;
        color: Palette.foreground;
    }

    SectionHeading {
        padding-top: 20px;
        padding-bottom: 8px;
        title: I18n.tr("settings.appearance.theme");
        help: I18n.tr("welcome.theme.help");
    }

    ThemeChoice { }

    Row {
        label: I18n.tr("settings.bar.edge");
        ComboBox {
            width: 240px;
            model: [I18n.tr("settings.bar.edge.top"), I18n.tr("settings.bar.edge.bottom")];
            current-index <=> SettingsState.edge;
            accessible-label: I18n.tr("settings.bar.edge");
            selected => {
                SettingsState.set-choice("bar.edge", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.general.autostart");
        help: I18n.tr("settings.general.autostart.help");
        error: SettingsState.autostart-error;
        Switch {
            checked <=> SettingsState.autostart;
            accessible-label: I18n.tr("settings.general.autostart");
            toggled => {
                SettingsState.set-flag("autostart", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("welcome.import");
        help: I18n.tr("welcome.import.help");
        Button {
            text: I18n.tr("welcome.import.button");
            clicked => {
                SettingsState.welcome-import();
            }
        }
    }

    SectionHeading {
        padding-top: 20px;
        padding-bottom: 8px;
        title: I18n.tr("welcome.tips");
    }

    VerticalLayout {
        spacing: 6px;
        Tip {
            text: I18n.tr("welcome.tip.menu");
        }

        Tip {
            text: I18n.tr("welcome.tip.drag");
        }

        Tip {
            text: I18n.tr("welcome.tip.hover");
        }

        Tip {
            text: I18n.tr-with("welcome.tip.hotkey", "hotkey", SettingsState.hotkey);
        }
    }

    HorizontalLayout {
        padding-top: 20px;
        alignment: end;
        Button {
            text: I18n.tr("welcome.done");
            primary: true;
            clicked => {
                SettingsState.welcome-done();
            }
        }
    }
}

component PropertiesPage inherits VerticalLayout {
    alignment: start;

    if SettingsState.props-error != "": Text {
        text: SettingsState.props-error;
        wrap: word-wrap;
        color: #d13438;
    }

    if SettingsState.props.length == 0: Text {
        text: I18n.tr("settings.props.noFields");
        wrap: word-wrap;
        color: Palette.foreground;
    }

    for row in SettingsState.props: VerticalLayout {
        if row.visible: Row {
            label: row.label;
            help: row.help;
            error: row.error;

            if row.kind == 0: LineEdit {
                width: 280px;
                text: row.text;
                accessible-label: row.label;
                edited(text) => {
                    SettingsState.prop-text(row.key, text);
                }
            }
            if row.kind == 1: Switch {
                checked: row.checked;
                accessible-label: row.label;
                toggled => {
                    SettingsState.prop-flag(row.key, self.checked);
                }
            }
            if row.kind == 2: ComboBox {
                width: 280px;
                model: row.options;
                current-index: row.index;
                accessible-label: row.label;
                selected => {
                    SettingsState.prop-choice(row.key, self.current-index);
                }
            }
            if row.kind == 3: ValueSlider {
                label: row.label;
                minimum: row.minimum;
                maximum: row.maximum;
                step: row.step;
                unit: row.unit;
                value: row.number;
                released(v) => {
                    SettingsState.prop-number(row.key, v);
                }
            }
            if row.kind == 4: ColorField {
                label: row.label;
                every-edit: true;
                value: row.text;
                accepted(text) => {
                    SettingsState.prop-text(row.key, text);
                }
            }
            if row.kind == 5: VerticalLayout {
                spacing: 8px;
                ComboBox {
                    width: 280px;
                    model: row.options;
                    current-index: row.index;
                    accessible-label: row.label;
                    selected => {
                        SettingsState.prop-color-mode(row.key, self.current-index, row.color);
                    }
                }
                // Custom: the colour.
                if row.index == 1: ColorField {
                    label: row.label;
                    every-edit: true;
                    value: row.color;
                    accepted(text) => {
                        SettingsState.prop-color-mode(row.key, row.index, text);
                    }
                }
            }
            if row.kind == 6 || row.kind == 7: HorizontalLayout {
                spacing: 8px;
                // Every edit counts, as in a text row: clicking Save does not take the focus, so
                // the box cannot wait for focus-out.
                LineEdit {
                    width: 280px;
                    text: row.text;
                    accessible-label: row.label;
                    edited(text) => {
                        SettingsState.prop-text(row.key, text);
                    }
                }
                Button {
                    text: I18n.tr("settings.props.browse");
                    clicked => {
                        SettingsState.prop-browse(row.key);
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        padding-top: 16px;
        Button {
            text: I18n.tr("settings.props.cancel");
            clicked => {
                SettingsState.props-cancel();
            }
        }

        Button {
            text: I18n.tr("settings.props.save");
            primary: true;
            enabled: SettingsState.props-valid;
            clicked => {
                SettingsState.props-save();
            }
        }
    }
}

// The sensor picker (SPEC §6.6): types by category, a search box, and for a target sensor
// where to insert.
// The search box and buttons stay; only the list scrolls, following the selection.
component PickerPage inherits VerticalLayout {
    spacing: 8px;
    padding-right: 20px;
    padding-bottom: 24px;

    // Scrolls the list so that a line `top` to `top + height` (in the list) is in view.
    function reveal(top: length, height: length) {
        if top < -list.content-y {
            list.content-y = -top;
        } else if top + height > -list.content-y + list.visible-height {
            list.content-y = -(top + height - list.visible-height);
        }
    }

    // Up and Down move the selection while the search box keeps the focus (SPEC §6.6).
    FocusScope {
        enabled: false;
        capture-key-pressed(event) => {
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                SettingsState.picker-step(event.text == Key.UpArrow);
                return accept;
            }
            reject
        }

        LineEdit {
            width: parent.width;
            placeholder-text: I18n.tr("settings.picker.search");
            text <=> SettingsState.picker-search;
            accessible-label: I18n.tr("settings.picker.search");
            init => {
                self.focus();
            }
            edited(text) => {
                SettingsState.picker-searched(text);
            }
            accepted => {
                if SettingsState.picker-selected >= 0 {
                    SettingsState.picker-add();
                }
            }
        }
    }

    if SettingsState.picker-target != "": HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text {
            text: I18n.tr("settings.picker.insert");
            vertical-alignment: center;
            color: Palette.foreground;
        }

        ComboBox {
            width: 120px;
            model: [I18n.tr("settings.picker.before"), I18n.tr("settings.picker.after")];
            current-index <=> SettingsState.picker-after;
            accessible-label: I18n.tr("settings.picker.insert");
        }

        Text {
            text: I18n.tr-with("settings.picker.target", "name", SettingsState.picker-target);
            vertical-alignment: center;
            wrap: word-wrap;
            color: Palette.foreground;
        }
    }

    if SettingsState.picker-rows.length == 0: Text {
        text: I18n.tr("settings.picker.none");
        wrap: word-wrap;
        color: Palette.foreground;
    }

    list := ScrollView {
        vertical-stretch: 1;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        content-height: lines.preferred-height;
        lines := VerticalLayout {
            width: list.visible-width - 16px;
            alignment: start;
            for row in SettingsState.picker-rows: line := VerticalLayout {
                if row.heading: Text {
                    text: row.name;
                    font-weight: 600;
                    color: Palette.foreground;
                    accessible-role: text;
                }
                if !row.heading: item := Rectangle {
                    property <bool> selected: SettingsState.picker-selected == row.entry;
                    changed selected => {
                        if self.selected {
                            root.reveal(line.y + self.y, self.height);
                        }
                    }
                    border-radius: 4px;
                    background: self.selected ? Palette.selection-background
                        : touch.has-hover ? Palette.alternate-background : transparent;
                    accessible-role: list-item;
                    accessible-label: row.name;
                    accessible-description: row.description;
                    accessible-item-selectable: true;
                    accessible-item-selected: self.selected;
                    accessible-action-default => {
                        SettingsState.picker-selected = row.entry;
                    }

                    touch := TouchArea {
                        clicked => {
                            SettingsState.picker-selected = row.entry;
                        }
                        double-clicked => {
                            SettingsState.picker-selected = row.entry;
                            SettingsState.picker-add();
                        }
                    }

                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        Text {
                            text: row.name;
                            color: item.selected ? Palette.selection-foreground : Palette.foreground;
                        }

                        Text {
                            text: row.description;
                            wrap: word-wrap;
                            font-size: 12px;
                            color: item.selected ? Palette.selection-foreground : Palette.foreground;
                            opacity: 0.7;
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        padding-top: 16px;
        Button {
            text: I18n.tr("settings.picker.cancel");
            clicked => {
                SettingsState.picker-cancel();
            }
        }

        Button {
            text: I18n.tr("settings.picker.add");
            primary: true;
            enabled: SettingsState.picker-selected >= 0;
            clicked => {
                SettingsState.picker-add();
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: I18n.tr("settings.title");
    icon: @image-url("../icons/32x32.png");
    preferred-width: 760px;
    preferred-height: 560px;
    min-width: 560px;
    min-height: 420px;
    background: Palette.background;
    // The page last shown, to go back to when the navigation is left without a selection.
    property <int> shown-page: 0;
    // The Fluent palette in the colour scheme (SPEC §10.3); `unknown` follows the OS, live.
    property <int> color-scheme: SettingsState.color-scheme;
    changed color-scheme => {
        root.apply-color-scheme();
    }
    init => {
        root.apply-color-scheme();
    }

    function apply-color-scheme() {
        Palette.color-scheme = root.color-scheme == 1 ? ColorScheme.light
            : root.color-scheme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    HorizontalLayout {
        VerticalLayout {
            width: 180px;
            padding: 8px;
            StandardListView {
                model: [
                    { text: I18n.tr("settings.nav.general") },
                    { text: I18n.tr("settings.nav.bar") },
                    { text: I18n.tr("settings.nav.appearance") },
                    { text: I18n.tr("settings.nav.sensors") },
                    { text: I18n.tr("settings.nav.popups") },
                    { text: I18n.tr("settings.nav.applications") },
                ];
                current-item <=> SettingsState.page;
                accessible-label: I18n.tr("settings.nav.label");
                changed current-item => {
                    // Ctrl+Space unselects the current item; the page stays.
                    if self.current-item < 0 {
                        self.current-item = root.shown-page;
                    } else if self.current-item != root.shown-page {
                        root.shown-page = self.current-item;
                        SettingsState.page-changed(self.current-item);
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Palette.border;
        }

        VerticalLayout {
            padding-left: 24px;
            padding-top: 16px;
            spacing: 8px;

            Text {
                text: SettingsState.page == 6 ? SettingsState.props-title
                    : SettingsState.page == 7 ? I18n.tr("settings.picker.title")
                    : SettingsState.page == 8 ? I18n.tr("welcome.title") : [
                    I18n.tr("settings.nav.general"),
                    I18n.tr("settings.nav.bar"),
                    I18n.tr("settings.nav.appearance"),
                    I18n.tr("settings.nav.sensors"),
                    I18n.tr("settings.nav.popups"),
                    I18n.tr("settings.nav.applications"),
                ][SettingsState.page];
                font-size: 20px;
                font-weight: 600;
                color: Palette.foreground;
            }

            if SettingsState.save-error != "": Text {
                text: I18n.tr-with("settings.saveError", "error", SettingsState.save-error);
                wrap: word-wrap;
                color: #d13438;
            }

            if SettingsState.page != 7: scroll := ScrollView {
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: content.preferred-height;
                content := VerticalLayout {
                    width: scroll.visible-width - 20px;
                    padding-bottom: 24px;
                    if SettingsState.page == 0: GeneralPage { }
                    if SettingsState.page == 1: BarPage { }
                    if SettingsState.page == 2: AppearancePage { }
                    if SettingsState.page == 3: SensorsPage { }
                    if SettingsState.page == 4: PopupsPage { }
                    if SettingsState.page == 5: ApplicationsPage { }
                    if SettingsState.page == 6: PropertiesPage { }
                    if SettingsState.page == 8: WelcomePage { }
                }
            }
            // The picker scrolls only its list (SPEC §6.6).
            if SettingsState.page == 7: PickerPage {
                vertical-stretch: 1;
            }
        }
    }
}
