    }

    Row {
        label: I18n.tr("settings.fontStyle");
        ComboBox {
            width: 280px;
            model: SettingsState.popup-font-styles;
            current-index <=> SettingsState.popup-font-style;
            accessible-label: I18n.tr("settings.fontStyle");
            selected => {
                SettingsState.set-font-style("popups.fontStyle", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.popups.fontSize");
        ValueSlider {
            label: I18n.tr("settings.popups.fontSize");
            minimum: 9;
            maximum: 15;
            value <=> SettingsState.popup-font-size;
            released(v) => {
                SettingsState.set-number("popups.fontSize", v);
            }
        }
