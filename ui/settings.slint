}

// The properties form, generated from the sensor type's schema (SPEC §6.7).
component PropertiesPage inherits VerticalLayout {
    alignment: start;

    if SettingsState.props-error != "": Text {
        text: SettingsState.props-error;
        wrap: word-wrap;
        color: #d13438;
    }

    if SettingsState.props.length == 0: Text {
        text: I18n.tr("settings.props.noFields");
        wrap: word-wrap;
        color: Palette.foreground;
    }

    for row in SettingsState.props: VerticalLayout {
        if row.visible: Row {
            label: row.label;
            help: row.help;

            if row.kind == 0: LineEdit {
                width: 280px;
                text: row.text;
                accessible-label: row.label;
                edited(text) => {
                    SettingsState.prop-text(row.key, text);
                }
            }
            if row.kind == 1: Switch {
                checked: row.checked;
                accessible-label: row.label;
                toggled => {
                    SettingsState.prop-flag(row.key, self.checked);
                }
            }
            if row.kind == 2: ComboBox {
                width: 280px;
                model: row.options;
                current-index: row.index;
                accessible-label: row.label;
                selected => {
                    SettingsState.prop-choice(row.key, self.current-index);
                }
            }
            if row.kind == 3: ValueSlider {
                label: row.label;
                minimum: row.minimum;
                maximum: row.maximum;
                step: row.step;
                unit: row.unit;
                value: row.number;
                released(v) => {
                    SettingsState.prop-number(row.key, v);
                }
            }
            if row.kind == 4: ColorField {
                label: row.label;
                value: row.text;
                accepted(text) => {
                    SettingsState.prop-text(row.key, text);
                }
            }
            if row.kind == 5: VerticalLayout {
                spacing: 8px;
                ComboBox {
                    width: 280px;
                    model: row.options;
                    current-index: row.index;
                    accessible-label: row.label;
                    selected => {
                        SettingsState.prop-color-mode(row.key, self.current-index, row.color);
                    }
                }
                // Custom: the colour.
                if row.index == 1: ColorField {
                    label: row.label;
                    value: row.color;
                    accepted(text) => {
                        SettingsState.prop-color-mode(row.key, row.index, text);
                    }
                }
            }
            if row.kind == 6 || row.kind == 7: HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    width: 280px;
                    text: row.text;
                    accessible-label: row.label;
                    accepted(text) => {
                        SettingsState.prop-text(row.key, text);
                    }
                    changed has-focus => {
                        if !self.has-focus {
                            SettingsState.prop-text(row.key, self.text);
                        }
                    }
                }
                Button {
                    text: I18n.tr("settings.props.browse");
                    clicked => {
                        SettingsState.prop-browse(row.key);
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        padding-top: 16px;
        Button {
            text: I18n.tr("settings.props.cancel");
            clicked => {
                SettingsState.props-cancel();
            }
        }

        Button {
            text: I18n.tr("settings.props.save");
            primary: true;
            clicked => {
                SettingsState.props-save();
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: I18n.tr("settings.title");
    icon: @image-url("../icons/32x32.png");
    preferred-width: 760px;
    preferred-height: 560px;
    min-width: 560px;
    min-height: 420px;
    background: Palette.background;

    HorizontalLayout {
        VerticalLayout {
            width: 180px;
            padding: 8px;
            StandardListView {
                model: [
                    { text: I18n.tr("settings.nav.general") },
                    { text: I18n.tr("settings.nav.bar") },
                    { text: I18n.tr("settings.nav.sensors") },
                    { text: I18n.tr("settings.nav.popups") },
                ];
                current-item <=> SettingsState.page;
                accessible-label: I18n.tr("settings.nav.label");
                changed current-item => {
                    SettingsState.page-changed(self.current-item);
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Palette.border;
        }

        VerticalLayout {
            padding-left: 24px;
            padding-top: 16px;
            spacing: 8px;

            Text {
                text: SettingsState.page == 4 ? SettingsState.props-title : [
                    I18n.tr("settings.nav.general"),
                    I18n.tr("settings.nav.bar"),
                    I18n.tr("settings.nav.sensors"),
                    I18n.tr("settings.nav.popups"),
                ][SettingsState.page];
                font-size: 20px;
                font-weight: 600;
                color: Palette.foreground;
            }

            if SettingsState.save-error != "": Text {
                text: I18n.tr-with("settings.saveError", "error", SettingsState.save-error);
                wrap: word-wrap;
                color: #d13438;
            }

            scroll := ScrollView {
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: content.preferred-height;
                content := VerticalLayout {
                    width: scroll.visible-width - 20px;
                    padding-bottom: 24px;
                    if SettingsState.page == 0: GeneralPage { }
                    if SettingsState.page == 1: BarPage { }
                    if SettingsState.page == 2: SensorsPage { }
                    if SettingsState.page == 3: PopupsPage { }
                    if SettingsState.page == 4: PropertiesPage { }
                }
            }
        }
    }
}
