// The welcome page's theme choice (SPEC §11.5): a tile per theme with a preview of the bar, chosen
// by a click or, once it has the focus, the arrow keys.
component ThemeChoice inherits FocusScope {
    height: tiles.preferred-height;
    accessible-role: list;
    accessible-label: I18n.tr("settings.appearance.theme");
    // The chosen theme, read with the list and again when the arrow keys change it.
    accessible-value: SettingsState.theme >= 0
        && SettingsState.theme < SettingsState.welcome-themes.length
        ? SettingsState.welcome-themes[SettingsState.theme].name : "";
    key-pressed(event) => {
        if (event.text == Key.LeftArrow || event.text == Key.UpArrow) && SettingsState.theme > 0 {
            SettingsState.set-choice("theme", SettingsState.theme - 1);
            return accept;
        }
        if (event.text == Key.RightArrow || event.text == Key.DownArrow)
            && SettingsState.theme < SettingsState.welcome-themes.length - 1 {
            SettingsState.set-choice("theme", SettingsState.theme + 1);
            return accept;
        }
        reject
    }

    tiles := HorizontalLayout {
        alignment: start;
        spacing: 12px;
        for tile[i] in SettingsState.welcome-themes: Rectangle {
            width: 252px;
            height: content.preferred-height;
            border-radius: 6px;
            border-width: tile.selected ? 2px : 1px;
            border-color: tile.selected ? (root.has-focus ? Palette.foreground : Palette.accent-background)
                : Look.card-stroke;
            background: touch.has-hover ? Look.card-hover : Look.card;
            accessible-role: list-item;
            accessible-label: tile.name;
            accessible-item-selectable: true;
            accessible-item-selected: tile.selected;
            accessible-item-index: i;
            accessible-item-count: SettingsState.welcome-themes.length;
            accessible-action-default => {
                SettingsState.set-choice("theme", i);
            }

            touch := TouchArea {
                clicked => {
                    root.focus();
                    SettingsState.set-choice("theme", i);
                }
            }

            content := VerticalLayout {
                padding: 6px;
                spacing: 6px;
                // At the bar's own height (physical px of the preview).
                if tile.has-preview: Image {
                    width: 240px;
                    height: tile.preview.height * 1phx;
                    source: tile.preview;
                    image-fit: fill;
                }
                if !tile.has-preview: Rectangle {
                    width: 240px;
                    height: 28px;
                    background: tile.swatch;
                }
                Text {
                    text: tile.name;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }
            }
        }
    }
}

