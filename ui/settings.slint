        }
    }

    Row {
        label: I18n.tr("settings.popups.strongTextColor");
        help: I18n.tr("settings.popups.strongTextColor.help");
        ColorField {
            label: I18n.tr("settings.popups.strongTextColor");
            value <=> SettingsState.popup-strong-color;
            accepted(text) => {
                SettingsState.set-color("popups.strongTextColor", text);
            }
        }
    }

    Row {
        label: I18n.tr("settings.font");
        ComboBox {
            width: Look.wide-control-width;
            model: SettingsState.fonts;
            current-index <=> SettingsState.popup-font;
            accessible-label: I18n.tr("settings.font");
            selected => {
                SettingsState.set-font("popups.font", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.fontStyle");
        ComboBox {
            width: Look.wide-control-width;
            model: SettingsState.popup-font-styles;
            current-index <=> SettingsState.popup-font-style;
            accessible-label: I18n.tr("settings.fontStyle");
            selected => {
                SettingsState.set-font-style("popups.fontStyle", self.current-index);
            }
        }
    }

    Row {
        label: I18n.tr("settings.popups.fontSize");
        ValueSlider {
            label: I18n.tr("settings.popups.fontSize");
            minimum: 9;
            maximum: 15;
            value <=> SettingsState.popup-font-size;
            released(v) => {
                SettingsState.set-number("popups.fontSize", v);
            }
        }
    }

    Row {
        label: I18n.tr("settings.popups.shadow");
        OnOffSwitch {
            checked <=> SettingsState.popup-shadow;
            label: I18n.tr("settings.popups.shadow");
            toggled => {
                SettingsState.set-flag("popups.shadow", self.checked);
            }
        }
    }

    Row {
        label: I18n.tr("settings.popups.showDelay");
        ValueSlider {
            label: I18n.tr("settings.popups.showDelay");
            minimum: 0;
            maximum: 2000;
            step: 50;
            unit: "common.ms";
            value <=> SettingsState.show-delay;
            released(v) => {
                SettingsState.set-number("popups.showDelayMs", v);
            }
        }
    }

    Row {
        label: I18n.tr("settings.popups.hideDelay");
        ValueSlider {
            label: I18n.tr("settings.popups.hideDelay");
            minimum: 0;
            maximum: 1000;
            step: 50;
            unit: "common.ms";
            value <=> SettingsState.hide-delay;
            released(v) => {
                SettingsState.set-number("popups.hideDelayMs", v);
            }
        }
    }
}

