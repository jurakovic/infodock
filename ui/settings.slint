component PropertiesPage inherits VerticalLayout {
    alignment: start;

    if SettingsState.props-error != "": Text {
        text: SettingsState.props-error;
        wrap: word-wrap;
        color: #d13438;
    }

    if SettingsState.props.length == 0: Text {
        text: I18n.tr("settings.props.noFields");
        wrap: word-wrap;
        color: Palette.foreground;
    }

    for row in SettingsState.props: VerticalLayout {
        if row.visible: Row {
            label: row.label;
            help: row.help;
            error: row.error;

            if row.kind == RowKinds.text: LineEdit {
                width: Look.wide-control-width;
                text: row.text;
                accessible-label: row.label;
                edited(text) => {
                    SettingsState.prop-text(row.key, text);
                }
            }
            if row.kind == RowKinds.flag: OnOffSwitch {
                checked: row.checked;
                label: row.label;
                toggled => {
                    SettingsState.prop-flag(row.key, self.checked);
                }
            }
            if row.kind == RowKinds.choice: ComboBox {
                width: Look.wide-control-width;
                model: row.options;
                current-index: row.index;
                accessible-label: row.label;
                selected => {
                    SettingsState.prop-choice(row.key, self.current-index);
                }
            }
            if row.kind == RowKinds.number: ValueSlider {
                label: row.label;
                minimum: row.minimum;
                maximum: row.maximum;
                step: row.step;
                unit: row.unit;
                value: row.number;
                released(v) => {
                    SettingsState.prop-number(row.key, v);
                }
            }
            if row.kind == RowKinds.color: ColorField {
                label: row.label;
                every-edit: true;
                value: row.text;
                accepted(text) => {
                    SettingsState.prop-text(row.key, text);
                }
            }
            if row.kind == RowKinds.color-mode: VerticalLayout {
                spacing: 8px;
                ComboBox {
                    width: Look.wide-control-width;
                    model: row.options;
                    current-index: row.index;
                    accessible-label: row.label;
                    selected => {
                        SettingsState.prop-color-mode(row.key, self.current-index, row.color);
                    }
                }
                // Custom: the colour.
                if row.index == 1: ColorField {
                    label: row.label;
                    every-edit: true;
                    value: row.color;
                    accepted(text) => {
                        SettingsState.prop-color-mode(row.key, row.index, text);
                    }
                }
            }
            if row.kind == RowKinds.file || row.kind == RowKinds.folder: HorizontalLayout {
                spacing: 8px;
                // Every edit counts, as in a text row: clicking Save does not take the focus, so
                // the box cannot wait for focus-out.
                LineEdit {
                    width: Look.path-width;
                    text: row.text;
                    accessible-label: row.label;
                    edited(text) => {
                        SettingsState.prop-text(row.key, text);
                    }
                }
                Button {
                    text: I18n.tr("settings.props.browse");
                    clicked => {
                        SettingsState.prop-browse(row.key);
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        padding-top: 16px;
        Button {
            text: I18n.tr("settings.props.cancel");
            clicked => {
                SettingsState.props-cancel();
            }
        }

        Button {
            text: I18n.tr("settings.props.save");
            primary: true;
            enabled: SettingsState.props-valid;
            clicked => {
                SettingsState.props-save();
            }
        }
    }
}

// The sensor picker (SPEC §6.6): types by category, a search box, and for a target sensor
// where to insert.
// The search box and buttons stay; only the list scrolls, following the selection.
component PickerPage inherits VerticalLayout {
    spacing: 8px;
    padding-right: 20px;
    padding-bottom: 24px;

    // Scrolls the list so that a line `top` to `top + height` (in the list) is in view.
    function reveal(top: length, height: length) {
        if top < -list.content-y {
            list.content-y = -top;
        } else if top + height > -list.content-y + list.visible-height {
            list.content-y = -(top + height - list.visible-height);
        }
    }

    // Up and Down move the selection while the search box keeps the focus (SPEC §6.6).
    FocusScope {
        enabled: false;
        capture-key-pressed(event) => {
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                SettingsState.picker-step(event.text == Key.UpArrow);
                return accept;
            }
            reject
        }

        LineEdit {
            width: parent.width;
            placeholder-text: I18n.tr("settings.picker.search");
            text <=> SettingsState.picker-search;
            accessible-label: I18n.tr("settings.picker.search");
            init => {
                self.focus();
            }
            edited(text) => {
                SettingsState.picker-searched(text);
            }
            accepted => {
                if SettingsState.picker-selected >= 0 {
                    SettingsState.picker-add();
                }
            }
        }
    }

    if SettingsState.picker-target != "": HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text {
            text: I18n.tr("settings.picker.insert");
            vertical-alignment: center;
            color: Palette.foreground;
        }

        ComboBox {
            width: 120px;
            model: [I18n.tr("settings.picker.before"), I18n.tr("settings.picker.after")];
            current-index <=> SettingsState.picker-after;
            accessible-label: I18n.tr("settings.picker.insert");
        }

        Text {
            text: I18n.tr-with("settings.picker.target", "name", SettingsState.picker-target);
            vertical-alignment: center;
            wrap: word-wrap;
            color: Palette.foreground;
        }
    }

    if SettingsState.picker-rows.length == 0: Text {
        text: I18n.tr("settings.picker.none");
        wrap: word-wrap;
        color: Palette.foreground;
    }

    list := ScrollView {
        vertical-stretch: 1;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        content-height: lines.preferred-height;
        lines := VerticalLayout {
            x: 0;
            width: list.visible-width - 16px;
            alignment: start;
            spacing: 4px;
            for row[i] in SettingsState.picker-rows: line := VerticalLayout {
                // A category's heading, above its cards.
                if row.heading: VerticalLayout {
                    padding-top: i == 0 ? 0 : 12px;
                    Text {
                        text: row.name;
                        font-weight: 600;
                        color: Palette.foreground;
                        accessible-role: text;
                    }
                }
                if !row.heading: item := Rectangle {
                    property <bool> selected: SettingsState.picker-selected == row.entry;
                    changed selected => {
                        if self.selected {
                            root.reveal(line.y + self.y, self.height);
                        }
                    }
                    border-radius: Look.radius;
                    border-width: 1px;
                    border-color: Look.card-stroke;
                    background: self.selected ? Look.card-selected
                        : touch.has-hover ? Look.card-hover : Look.card;
                    accessible-role: list-item;
                    accessible-label: row.name;
                    accessible-description: row.description;
                    accessible-item-selectable: true;
                    accessible-item-selected: self.selected;
                    accessible-action-default => {
                        SettingsState.picker-selected = row.entry;
                    }

                    touch := TouchArea {
                        clicked => {
                            SettingsState.picker-selected = row.entry;
                        }
                        double-clicked => {
                            SettingsState.picker-selected = row.entry;
                            SettingsState.picker-add();
                        }
                    }

                    if item.selected: Rectangle {
                        x: 0;
                        y: (parent.height - 16px) / 2;
                        width: 3px;
                        height: 16px;
                        border-radius: 1.5px;
                        background: Palette.accent-background;
                    }

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        Text {
                            text: row.name;
                            color: Palette.foreground;
                        }

                        Text {
                            text: row.description;
                            wrap: word-wrap;
                            font-size: 12px;
                            color: Look.secondary-text;
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        padding-top: 16px;
        Button {
            text: I18n.tr("settings.picker.cancel");
            clicked => {
                SettingsState.picker-cancel();
            }
        }

        Button {
            text: I18n.tr("settings.picker.add");
            primary: true;
            enabled: SettingsState.picker-selected >= 0;
            clicked => {
                SettingsState.picker-add();
            }
        }
    }
}

// The pages as Windows 11's navigation shows them: an icon and a name, a subtle fill on the page
// hovered and the one shown, and the accent pill on the latter. One Tab stop; Up, Down, Home and
// End move to another page. A page it does not list (a sensor's properties, the picker, the
// welcome page) selects none. A click does not take the focus, so a colour being typed is saved
// first (SPEC §10.7).
component Navigation inherits FocusScope {
    in property <[NavItem]> items;
    in-out property <int> current;
    focus-on-click: false;
    property <bool> listed: root.current >= 0 && root.current < root.items.length;
    property <length> item-height: 36px;
    property <length> item-spacing: 4px;

    function go(page: int) {
        if page != root.current {
            root.current = page;
        }
    }

    accessible-role: list;
    key-pressed(event) => {
        if event.text == Key.UpArrow {
            root.go(root.listed ? max(0, root.current - 1) : root.items.length - 1);
            return accept;
        }
        if event.text == Key.DownArrow {
            root.go(root.listed ? min(root.items.length - 1, root.current + 1) : 0);
            return accept;
        }
        if event.text == Key.Home {
            root.go(0);
            return accept;
        }
        if event.text == Key.End {
            root.go(root.items.length - 1);
            return accept;
        }
        reject
    }

    VerticalLayout {
        alignment: start;
        spacing: root.item-spacing;
        for item[i] in root.items: Rectangle {
            property <bool> shown: i == root.current;
            height: root.item-height;
            border-radius: Look.radius;
            background: self.shown ? Look.subtle-selected
                : touch.has-hover ? Look.subtle-hover : transparent;
            // WinUI's fast fade on hover.
            animate background { duration: 83ms; }
            // The focus ring, on the page shown.
            border-width: root.has-focus && self.shown ? 2px : 0;
            border-color: Palette.foreground;
            accessible-role: list-item;
            accessible-label: item.text;
            accessible-item-selectable: true;
            accessible-item-selected: self.shown;
            accessible-item-index: i;
            accessible-item-count: root.items.length;
            accessible-action-default => {
                root.go(i);
            }

            touch := TouchArea {
                clicked => {
                    root.go(i);
                }
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 16px;
                        height: 16px;
                        source: item.icon;
                        colorize: Palette.foreground;
                    }
                }

                Text {
                    text: item.text;
                    vertical-alignment: center;
                    overflow: elide;
                    color: Palette.foreground;
                }
            }
        }
    }

    // The accent pill on the page shown; it slides to the next one, as WinUI's does.
    if root.listed: Rectangle {
        x: 0;
        y: root.current * (root.item-height + root.item-spacing) + (root.item-height - self.height) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Palette.accent-background;
        animate y { duration: 250ms; easing: ease-out; }
    }
}

export component SettingsWindow inherits Window {
    title: I18n.tr("settings.title");
    icon: @image-url("../icons/32x32.png");
    preferred-width: 760px;
    preferred-height: 560px;
    min-width: 560px;
    min-height: 420px;
    background: Look.window;
    // Windows 11's UI font, as WinUI uses it; where it is missing (Windows 10) Slint falls back
    // to Segoe UI.
    default-font-family: "Segoe UI Variable Text";
    // The page fades in when shown, as WinUI's pages enter. The fade first jumps back to
    // transparent (no animation while `page-restart`), then animates.
    property <int> page: SettingsState.page;
    property <float> page-opacity: 1;
    property <bool> page-restart;
    animate page-opacity {
        duration: root.page-restart ? 0ms : 167ms;
        easing: ease-out;
    }
    changed page => {
        root.page-restart = true;
        root.page-opacity = 0;
        root.page-restart = false;
        root.page-opacity = 1;
    }
    // The page last shown, so that each change of page is reported once.
    property <int> shown-page: 0;
    // The Fluent palette in the colour scheme (SPEC §10.3); `unknown` follows the OS, live.
    property <int> color-scheme: SettingsState.color-scheme;
    changed color-scheme => {
        root.apply-color-scheme();
    }
    init => {
        root.apply-color-scheme();
    }

    function apply-color-scheme() {
        Palette.color-scheme = root.color-scheme == 1 ? ColorScheme.light
            : root.color-scheme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    HorizontalLayout {
        VerticalLayout {
            width: 180px;
            padding: 8px;
            padding-top: 12px;
            Navigation {
                items: [
                    { text: I18n.tr("settings.nav.general"), icon: @image-url("icons/nav-general.svg") },
                    { text: I18n.tr("settings.nav.bar"), icon: @image-url("icons/nav-bar.svg") },
                    { text: I18n.tr("settings.nav.appearance"), icon: @image-url("icons/nav-appearance.svg") },
                    { text: I18n.tr("settings.nav.sensors"), icon: @image-url("icons/nav-sensors.svg") },
                    { text: I18n.tr("settings.nav.popups"), icon: @image-url("icons/nav-popups.svg") },
                    { text: I18n.tr("settings.nav.applications"), icon: @image-url("icons/nav-applications.svg") },
                    { text: I18n.tr("settings.nav.help"), icon: @image-url("icons/nav-help.svg") },
                    { text: I18n.tr("settings.nav.about"), icon: @image-url("icons/nav-about.svg") },
                ];
                current <=> SettingsState.page;
                accessible-label: I18n.tr("settings.nav.label");
                changed current => {
                    if self.current != root.shown-page {
                        root.shown-page = self.current;
                        SettingsState.page-changed(self.current);
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 24px;
            padding-top: 16px;
            spacing: 12px;

            Text {
                text: SettingsState.page == Pages.properties ? SettingsState.props-title
                    : SettingsState.page == Pages.picker ? I18n.tr("settings.picker.title")
                    : SettingsState.page == Pages.welcome ? I18n.tr("welcome.title") : [
                    I18n.tr("settings.nav.general"),
                    I18n.tr("settings.nav.bar"),
                    I18n.tr("settings.nav.appearance"),
                    I18n.tr("settings.nav.sensors"),
                    I18n.tr("settings.nav.popups"),
                    I18n.tr("settings.nav.applications"),
                    I18n.tr("settings.nav.help"),
                    I18n.tr("settings.nav.about"),
                ][SettingsState.page];
                // Windows 11's Title, in the font's cut for large text.
                font-family: "Segoe UI Variable Display";
                font-size: 28px;
                font-weight: 600;
                color: Palette.foreground;
            }

            if SettingsState.save-error != "": Text {
                text: I18n.tr-with("settings.saveError", "error", SettingsState.save-error);
                wrap: word-wrap;
                color: #d13438;
            }

            if SettingsState.page != Pages.picker: scroll := ScrollView {
                opacity: root.page-opacity;
                horizontal-scrollbar-policy: always-off;
                content-width: self.visible-width;
                content-height: content.preferred-height;
                // Beside the scrollbar, and no wider than Windows 11 Settings lets its cards be;
                // on the left, in line with the title (an element narrower than its parent is
                // centred otherwise).
                content := VerticalLayout {
                    x: 0;
                    width: min(scroll.visible-width - 20px, 1000px);
                    padding-bottom: 24px;
                    if SettingsState.page == Pages.general: GeneralPage { }
                    if SettingsState.page == Pages.bar: BarPage { }
                    if SettingsState.page == Pages.appearance: AppearancePage { }
                    if SettingsState.page == Pages.sensors: SensorsPage { }
                    if SettingsState.page == Pages.popups: PopupsPage { }
                    if SettingsState.page == Pages.applications: ApplicationsPage { }
                    if SettingsState.page == Pages.help: HelpPage { }
                    if SettingsState.page == Pages.about: AboutPage { }
                    if SettingsState.page == Pages.properties: PropertiesPage { }
                    if SettingsState.page == Pages.welcome: WelcomePage { }
                }
            }
            // The picker scrolls only its list (SPEC §6.6).
            if SettingsState.page == Pages.picker: PickerPage {
                opacity: root.page-opacity;
                vertical-stretch: 1;
            }
        }
    }
}
